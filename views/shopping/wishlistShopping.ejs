<%- include("./commonHeader/header") %>
<%- include("./commonHeader/navbar1") %>

<div style="max-width: 1200px; margin: 30px auto; padding: 0 20px;">
  <h2>My Wishlist (<%= products.length %>)</h2>

  <% if (products.length === 0) { %>
    <div style="text-align: center; padding: 50px;">
      <p style="color: #666;">Your wishlist is empty!</p>
      <a href="/" style="color: #03045e; font-weight: bold;">Continue Shopping</a>
    </div>
  <% } else { %>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 20px; margin-top: 20px;">
      <% products.forEach(product => { %>
        <div style="border: 1px solid #ddd; border-radius: 8px; padding: 15px; background: white;">
          <img src="<%= product.image %>" style="width: 100%; height: 180px; object-fit: contain;">
          <p style="font-weight: bold; background-color: green; color: yellow; height: 25px; display: flex; align-items: center; width: 50px; border-radius: 7px; padding-left: 5px;">⭐<%= product.rating %></p>
          <h4 style="margin: 10px 0; font-size: 16px;"><%= product.title %></h4>
          <p style="font-weight: bold; color: #111;">₹<%= product.price %></p>
          
          <div class="product-card-actions">
            <!-- 1. Buy Now Button (FIXED HERE) -->
            <a href="/checkout?productId=<%= product._id %>" class="btn buy-now-btn">
              Buy Now
            </a>

            <!-- 2. Remove Button -->
            <button class="btn remove-btn" onclick="removeFromWishlist('<%= product._id %>')">
              <i class="fa-solid fa-trash"></i> Remove
            </button>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<style>
.product-card-actions {
  display: flex;
  gap: 10px;
  margin-top: 15px;
  align-items: center;
}

.buy-now-btn {
  background-color: #ff9f00;
  color: white;
  padding: 6px 10px;
  border-radius: 6px;
  text-decoration: none;
  font-weight: 600;
  font-size: 14px;
  display: inline-block;
  transition: background 0.2s ease;
}

.buy-now-btn:hover {
  background-color: #e68f00;
}

.remove-btn {
  background-color: #dc3545;
  color: white;
  border: none;
  padding: 6px 10px;
  border-radius: 6px;
  cursor: pointer;
  font-size: 14px;
  transition: background 0.2s ease;
}

.remove-btn:hover {
  background-color: #c82333;
}
</style>

<script>
async function removeFromWishlist(productId) {
    if (!confirm("Are you sure you want to remove this item?")) return;

    try {
        const response = await fetch('/wishlistShopping/remove', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ productId: productId })
        });

        const data = await response.json();

        if (response.ok && data.success) {
            window.location.reload();
        } else {
            alert(data.message || "Failed to remove product from wishlist");
        }

    } catch (err) {
        console.error("Remove Wishlist Error:", err);
        alert("Server error. Please try again.");
    }
}
</script>

<%- include("./commonHeader/footer") %>