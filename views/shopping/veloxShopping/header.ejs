        <section class="hero-section">

            <!-- Left Arrow -->
            <button class="hero-btn hero-prev" onclick="prevSlide()">
                <i class="fa-solid fa-chevron-left"></i>
            </button>

            <!-- Slides -->
            <div class="hero-slider">

                <div class="hero-slide">
