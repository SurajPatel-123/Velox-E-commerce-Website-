        /* ================= HERO SECTION ================= */

        .hero-section {
            position: relative;
            width: 100%;
            height: 320px;
            overflow: hidden;
            border-radius: 15px;
            margin-top: 5px;
            background: #f5f5f5;
        }

        .hero-slider {
            display: flex;
            width: 100%;
            height: 300px;
            transition: transform 0.6s ease-in-out;
        }

        .hero-slide {
            min-width: 100%;
            width: 100%;
            height: 300px;
            flex-shrink: 0;
            overflow: hidden;
        }

        .hero-slide img {
            width: 100%;
            height: 300px;
            display: block;
            object-fit: cover;
            object-position: center;
        }

        /* ================= ARROWS ================= */

        .hero-btn {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            height: 40px;
            width: 40px;
            border: none;
            outline: none;
            background: rgba(255, 255, 255, 0.85);
            color: #03045e;
            font-size: 20px;
            cursor: pointer;
            z-index: 5;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
        }

        .hero-btn:hover {
            background: white;
            color: #0077b6;
            transform: translateY(-50%) scale(1.05);
        }

        .hero-prev {
            left: 10px;
            border-radius: 50%;
        }

        .hero-next {
            right: 10px;
            border-radius: 50%;
        }

        /* ================= DOTS ================= */

        .hero-dots {
            position: absolute;
            bottom: 8px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 8px;
            z-index: 10;
        }

        .hero-dot {
            width: 9px;
            height: 9px;
            background: #aaa;
            border-radius: 50%;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .hero-dot.active {
            width: 25px;
            border-radius: 10px;
            background: #03045e;
        }

        .hero-dot:hover {
            background: #0077b6;
        }

        /* ================= RESPONSIVE ================= */

        @media (max-width: 900px) {
            .hero-section {
                height: 280px;
            }

            .hero-slider,
            .hero-slide,
            .hero-slide img {
