<style>
    /* ================= TOP NAVBAR ================= */
    .container1 {
        height: 48px;
        margin-top: -3px;
        width: 100%;
        display: flex;
        align-items: center;
        text-align: center;
        justify-content: space-evenly;
    }

    /* LOGO */
    .velox {
        display: flex;
        align-items: center;
        cursor: pointer;
        padding: 4px;
        box-sizing: border-box;
    }

    .icon5 {
        height: 30px;
        width: 38px;
        border-radius: 6px;
    }

    .velox p {
        margin: 0 0 0 6px;
        font-size: 1.3rem;
        color: #f84464;
    }
    .velox:hover {
        border: 1px solid #f84464;
        border-radius: 7px;
    }

    /* LOCATION */
   .location { color: #777; height: 40px; width: 120px; padding-left: 5px; display: flex; align-items: center; gap: 5px; cursor: pointer; box-sizing: border-box; }
    .location i { color: #f84464 !important; }
    .location:hover { color: #f84464; border: 1px solid #f84464; border-radius: 5px; }

    /* SEARCH BOX */
    .search-wrapper {
        position: relative;
    }

    .search-box {
        height: 35px;
        display: flex;
        align-items: center;
    }

    .search-category {
        height: 35px;
        width: 110px;
        background-color: #fef2f4;
        border: 1.5px solid #f84464;
        border-right: none;
        outline: none;
        border-radius: 7px 0 0 7px;
        color: #333;
        cursor: pointer;
        padding: 0 5px;
        font-size: 13px;
    }

    .search-input {
        height: 35px;
        width: 280px;
        padding: 0 10px;
        outline: none;
        border: 1.5px solid #f84464;
        box-sizing: border-box;
        font-size: 13.5px;
        color: #333;
    }

    .search-btn {
        height: 35px;
        padding: 0 16px;
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        outline: none;
        background-color: #f84464;
        color: white;
        cursor: pointer;
        border-radius: 0 7px 7px 0;
        font-size: 13.5px;
        font-weight: 600;
        transition: background 0.2s ease;
    }

    .search-btn:hover {
        background-color: #e03554;
    }

    /* SUGGESTIONS DROPDOWN */
    .search-suggestions {
        display: none;
        position: absolute;
        top: 37px;
        left: 0;
        width: 100%;
        background-color: #ffffff;
        border: 1.5px solid #f84464;
        border-radius: 0 0 7px 7px;
        box-shadow: 0px 4px 10px rgba(0,0,0,0.1);
        z-index: 999;
    }

    .search-suggestion-item {
        padding: 8px 12px;
        cursor: pointer;
        font-size: 13.5px;
        color: #333;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .search-suggestion-item i {
        color: #f84464;
    }

    .search-suggestion-item:hover {
        background-color: #fef2f4;
        color: #f84464;
    }

    .suggestion-category {
        margin-left: auto;
        font-size: 11px;
        color: #ffffff;
        background: #f84464;
        padding: 2px 6px;
        border-radius: 4px;
    }

    /* USER / WISHLIST / TICKETS */
    .user {
        position: relative;
        display: flex;
        align-items: center;
        height: 35px;
        width: 115px;
        padding-left: 10px;
        color: #f84464;
        cursor: pointer;
        font-size: 14px;
    }
    .user:hover {
        border: 1px solid #f84464;
        border-radius: 7px;
    }
    .user-dropdown {
        display: none;
        position: absolute;
        top: 36px;
        right: 0;
        background-color: #ffffff;
        box-shadow: 0px 4px 10px rgba(0,0,0,0.15);
        border: 1px solid #ddd;
        border-radius: 6px;
        width: 120px;
        z-index: 1000;
        overflow: hidden;
    }

    .user-dropdown a {
        display: block;
        padding: 8px 12px;
        color: #333;
        text-decoration: none;
        font-size: 13px;
    }

    .user-dropdown a:hover {
        background-color: #fef2f4;
        color: #f84464;
    }

    .user:hover .user-dropdown {
        display: block;
    }

    .wish {
        display: flex;
        align-items: center;
        gap: 5px;
        padding-left: 5px;
        height: 35px;
        width: 74px;
        cursor: pointer;
        color: #f84464;
        font-size: 14px;
    }

    .wish p, .cart p {
        margin: 0;
    }
    .wish:hover {
        border: 1px solid #f84464;
        border-radius: 7px;
    }
    .cart {
        display: flex;
        align-items: center;
        gap: 5px;
        height: 35px;
        width: 100px;
        padding-left: 8px;
        cursor: pointer;
        color: #f84464;
        font-size: 14px;
    }
    .cart i {
        font-size: 20px;
    }
    .cart:hover {
        border: 1px solid #f84464;
        border-radius: 7px;
    }

    /* BOTTOM MENU */
    .menu-line {
        border: none;
        border-top: 1px solid #f84464;
        margin: 0;
    }

    .entertainment-menu {
        width: 100%;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: space-around;
        background-color: #ffffff;
        padding: 0 10px;
        box-sizing: border-box;
    }

    .entertainment-menu div {
        display: flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
        color: #f84464;
        font-size: 14px;
        font-weight: 500;
        padding: 4px 8px;
        border-radius: 4px;
        transition: background 0.2s;
    }

    .entertainment-menu div:hover {
        background-color: #fbd4da;
    }

    .entertainment-menu div:first-child {
        font-weight: bold;
    }
</style>

<!-- ================= TOP NAVBAR ================= -->
<div class="container1">

    <!-- VELOX LOGO -->
    <div onclick="window.location.reload()" class="velox">
        <img class="icon5" src="/Images/icon5.png" alt="Velox Logo">
        <p><b>Velox</b></p>
    </div>

    
        <div class="location" onclick="getUserLocation()" style="display: flex; align-items: center; width: auto; max-width: 280px; cursor: pointer; gap: 8px;">
            <i style="color:#f84464; font-size: 18px;" class="fa-solid fa-location-crosshairs"></i>
            <p id="location-text" style="margin: 0; line-height: 1.2; color: #333;">
                <span style="font-weight: 600; font-size: 14px;">Enter your location</span>
            </p>
        </div>

    <!-- SEARCH -->
    <div class="search-wrapper">
        <div class="search-box">
            <select id="searchCategory" class="search-category">
                <option value="all">All</option>
                <option value="Movies">Movies</option>
                <option value="Events">Events</option>
                <option value="Plays">Plays</option>
                <option value="Sports">Sports</option>
                <option value="Concerts">Concerts</option>
                <option value="Comedy Shows">Comedy Shows</option>
                <option value="Activities">Activities</option>
            </select>

            <input
                type="text"
                id="searchInput"
                class="search-input"
                placeholder="Search movies, events, plays..."
                autocomplete="off"
            >

            <button type="button" id="searchButton" class="search-btn">
                <i class="fa-solid fa-magnifying-glass"></i>
                <span>Search</span>
            </button>
        </div>

        <!-- SEARCH SUGGESTIONS DROPDOWN -->
        <div id="searchSuggestions" class="search-suggestions"></div>
    </div>

    <!-- USER -->
    <div class="user">
        <i class="fa-regular fa-user" style="margin-right: 5px; color: #f84464;"></i>
        
        <% if (typeof user !== 'undefined' && user) { %>
            <span style="font-weight: 600;">
                Hi, <%= (user.name || user.username || 'User').split(' ')[0] %>
            </span>

            <div class="user-dropdown">
                <a href="/auth/logout"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
            </div>
        <% } else { %>
            <a onclick="signup()" style="color: #f84464; cursor: pointer; text-decoration: none;">SignUp</a>
            <span style="margin: 0 2px;">/</span>
            <a onclick="login()" style="color: #f84464; cursor: pointer; text-decoration: none;">Login</a>
        <% } %>
    </div>

    <!-- WISHLIST -->
    <div onclick="wishlist()" class="wish">
        <i class="fa-regular fa-heart"></i>
        <p>Wishlist</p>
    </div>

    <!-- TICKETS -->
    <div class="cart" onclick="window.location.href='/bookmyshow/veloxBookShow/BookShowCart'">
        <i class="fa-solid fa-ticket"></i>
        <p>Tickets</p>
        <span id="cart-count">(0)</span>
    </div>

</div>

<hr class="menu-line">

<!-- ================= ENTERTAINMENT MENU ================= -->
<div class="entertainment-menu">
    <div>
        <i class="fa-solid fa-layer-group"></i>
        <span>Explore</span>
    </div>

    <div onclick="movies()">
        <i class="fa-solid fa-film"></i>
        <span>Movies</span>
    </div>

    <div onclick="events()">
        <i class="fa-solid fa-calendar-days"></i>
        <span>Events</span>
    </div>

    <div onclick="plays()">
        <i class="fa-solid fa-masks-theater"></i>
        <span>Plays</span>
    </div>

    <div onclick="concerts()">
        <i class="fa-solid fa-music"></i>
        <span>Concerts</span>
    </div>

    <div onclick="sports()">
        <i class="fa-solid fa-trophy"></i>
        <span>Sports</span>
    </div>

    <div onclick="activities()">
        <i class="fa-solid fa-child-reaching"></i>
        <span>Activities</span>
    </div>

    <div>
        <i class="fa-solid fa-percent"></i>
        <span>Offers</span>
    </div>
</div>

<hr class="menu-line">

<script>
    function activities() { window.location.href = "/bookmyshow/category/Activities"; }
    function sports() { window.location.href = "/bookmyshow/category/Sports"; }
    function concerts() { window.location.href = "/bookmyshow/category/Concerts"; }
    function plays() { window.location.href = "/bookmyshow/category/Plays"; }
    function events() { window.location.href = "/bookmyshow/category/Events"; }
    function movies() { window.location.href = "/bookmyshow/category/Movies"; }
    function signup() { window.location.href = "/auth/signup"; }
    function login() { window.location.href = "/auth/login"; }
    function wishlist() { window.location.href = "/wishlist/entertainment"; }

    async function updateCartCount() {
        try {
            const response = await fetch("/bookmyshow/veloxBookShow/BookShowCart/count");
            const data = await response.json();
            const countElement = document.querySelector("#cart-count");

            if (countElement) {
                countElement.textContent = `(${data.count || 0})`;
            }
        } catch (error) {
            console.log("Cart count error:", error);
        }
    }
    updateCartCount();

    /* ================= SEARCH LOGIC ================= */
    const searchInput = document.getElementById("searchInput");
    const searchCategory = document.getElementById("searchCategory");
    const searchButton = document.getElementById("searchButton");
    const searchSuggestions = document.getElementById("searchSuggestions");

    const suggestions = [
        { name: ["Stree 2", "Kalki 2898 AD", "Jawan", "Animal", "Deadpool & Wolverine"], category: "Movies" },
        { name: ["Sunburn Festival", "Standup Comedy Night", "Magic Show", "Food Fest"], category: "Events" },
        { name: ["Mughal-E-Azam", "The Lion King Play", "Hamlet", "Hindi Drama"], category: "Plays" },
        { name: ["IPL 2026", "ISL Football", "Pro Kabaddi", "Marathon"], category: "Sports" },
        { name: ["Arijit Singh Live", "Coldplay Tour", "Diljit Dosanjh Concert", "EDM Night"], category: "Concerts" },
        { name: ["Zakir Khan Live", "Anubhav Singh Bassi", "Samay Raina"], category: "Comedy Shows" },
        { name: ["Amusement Park", "Trampoline Park", "Water Park", "Ice Skating"], category: "Activities" }
    ];

    function performSearch() {
        const query = searchInput.value.trim();
        const category = searchCategory.value;

        if (!query) {
            searchInput.focus();
            return;
        }

        // URL construction with encoded parameters
        const encodedQuery = encodeURIComponent(query);
        let targetUrl = `/bookmyshow/search?query=${encodedQuery}`;
        
        if (category !== "all") {
            targetUrl += `&category=${encodeURIComponent(category)}`;
        }

        window.location.href = targetUrl;
    }

    searchButton.addEventListener("click", performSearch);

    searchInput.addEventListener("keydown", function (event) {
        if (event.key === "Enter") {
            event.preventDefault();
            performSearch();
        }
    });

    searchCategory.addEventListener("change", function () {
        if (searchInput.value.trim()) {
            performSearch();
        }
    });

    searchInput.addEventListener("input", function () {
        const value = searchInput.value.trim().toLowerCase();
        searchSuggestions.innerHTML = "";

        if (!value) {
            searchSuggestions.style.display = "none";
            return;
        }

        const selectedCategory = searchCategory.value;
        const matches = [];

        suggestions.forEach(item => {
            const matchesCategory = selectedCategory === "all" || item.category === selectedCategory;
            if (!matchesCategory) return;

            const namesArray = Array.isArray(item.name) ? item.name : [item.name];

            namesArray.forEach(term => {
                if (term.toLowerCase().includes(value)) {
                    matches.push({
                        displayName: term,
                        category: item.category
                    });
                }
            });
        });

        if (matches.length === 0) {
            searchSuggestions.style.display = "none";
            return;
        }

        matches.slice(0, 5).forEach(match => {
            const suggestion = document.createElement("div");
            suggestion.className = "search-suggestion-item";
            
            suggestion.innerHTML = `
                <i class="fa-solid fa-film"></i>
                <span>${match.displayName}</span>
                <span class="suggestion-category">${match.category}</span>
            `;

            suggestion.addEventListener("click", function () {
                searchInput.value = match.displayName;
                
                const categoryOption = Array.from(searchCategory.options).find(opt => opt.value === match.category || opt.text === match.category);
                if (categoryOption) {
                    searchCategory.value = categoryOption.value;
                }

                performSearch();
            });

            searchSuggestions.appendChild(suggestion);
        });

        searchSuggestions.style.display = "block";
    });

    document.addEventListener("click", function (event) {
        if (!event.target.closest(".search-wrapper")) {
            searchSuggestions.style.display = "none";
        }
    });

    /* ================= GEOLOCATION ================= */
    async function getUserLocation() {
        const locationText = document.getElementById("location-text");

        if (!navigator.geolocation) {
            alert("Geolocation is not supported by your browser");
            return;
        }

        locationText.innerHTML = `<span style="font-size: 13px; color: #666;">Locating...</span>`;

        navigator.geolocation.getCurrentPosition(
            async (position) => {
                const lat = position.coords.latitude;
                const lon = position.coords.longitude;

                try {
                    const response = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lon}`);
                    const data = await response.json();
                    const address = data.address;

                    const mainCity = address.city || address.town || address.village || address.suburb || address.county || "Detected Location";
                    const state = address.state || "";
                    const country = address.country || "";
                    const subLocation = [state, country].filter(Boolean).join(", ");

                    locationText.innerHTML = `
                        <span style="font-weight: bold; font-size: 14px; display: block; color: #111;">${mainCity}</span>
                        <span style="font-size: 11px; color: #666; display: block;">${subLocation}</span>
                    `;
                    locationText.title = data.display_name;

                } catch (error) {
                    console.error("Geocoding Error:", error);
                    locationText.innerHTML = `<span style="font-size: 13px; color: red;">Location Error</span>`;
                }
            },
            (error) => {
                console.error("Location Permission Error:", error);
                locationText.innerHTML = `<span style="font-size: 13px;">Enter your location</span>`;
                if (error.code === error.PERMISSION_DENIED) {
                    alert("Please allow location access in your browser settings.");
                } else {
                    alert("Unable to fetch location. Try again.");
                }
            }
        );
    }
</script>