
<footer class="velox-footer">

    <!-- Back To Top -->
    <div class="back-top" onclick="window.scrollTo({top:0, behavior:'smooth'})">
        <span>Back to top</span>
    </div>


    <!-- Footer Main -->
    <div class="footer-wrapper">

        <!-- Brand -->
        <div class="footer-brand">

            <div class="footer-logo">
                <img src="/Images/icon5.png" alt="Velox">
                <span>Velox</span>
            </div>

            <p class="brand-text">
                Your everyday shopping destination for
                electronics, fashion, mobiles, beauty,
                home appliances and much more.
            </p>

            <div class="footer-location">
                <i class="fa-solid fa-location-dot"></i>
                <span>Delivering across India</span>
            </div>

            <div class="social-links">

                <a href="#"><i class="fa-brands fa-facebook-f"></i></a>

                <a href="#"><i class="fa-brands fa-instagram"></i></a>

                <a href="#"><i class="fa-brands fa-x-twitter"></i></a>

                <a href="#"><i class="fa-brands fa-youtube"></i></a>

                <a href="#"><i class="fa-brands fa-linkedin-in"></i></a>

            </div>

        </div>


        <!-- Shop -->
        <div class="footer-links">

            <h3>Shop</h3>

            <a href="#">Mobiles</a>
            <a href="#">Laptops</a>
            <a href="#">Electronics</a>
            <a href="#">Fashion</a>
            <a href="#">Beauty</a>
            <a href="#">Home & Appliances</a>
            <a href="#">Sports</a>
            <a href="#">Books</a>

        </div>


        <!-- Help -->
        <div class="footer-links">

            <h3>Customer Care</h3>

            <a href="#">Help Center</a>
            <a href="#">Track Order</a>
            <a href="#">Shipping & Delivery</a>
            <a href="#">Returns & Refunds</a>
            <a href="#">Cancellation</a>
            <a href="#">FAQs</a>
            <a href="#">Contact Us</a>

        </div>


        <!-- Company -->
        <div class="footer-links">

            <h3>Company</h3>

            <a href="#">About Velox</a>
            <a href="#">Careers</a>
            <a href="#">Sell on Velox</a>
            <a href="#">Become a Partner</a>
            <a href="#">Privacy Policy</a>
            <a href="#">Terms & Conditions</a>

        </div>

    </div>


    <!-- Newsletter -->
    <div class="newsletter">

        <div class="newsletter-content">

            <div class="newsletter-icon">
                <i class="fa-regular fa-envelope"></i>
            </div>

            <div>
                <h2>Get the latest from Velox</h2>

                <p>
                    New arrivals, exclusive deals and special offers
                    delivered straight to your inbox.
                </p>
            </div>

        </div>


        <div class="subscribe-box">

            <input
                type="email"
                placeholder="Enter your email address"
            >

            <button>
                Subscribe
            </button>

        </div>

    </div>


    <!-- Trust Section -->
    <div class="trust-section">

        <div class="trust-item">
            <i class="fa-solid fa-shield-halved"></i>

            <div>
                <strong>Secure Payments</strong>
                <span>100% secure checkout</span>
            </div>
        </div>


        <div class="trust-item">
            <i class="fa-solid fa-truck-fast"></i>

            <div>
                <strong>Fast Delivery</strong>
                <span>Quick delivery across India</span>
            </div>
        </div>


        <div class="trust-item">
            <i class="fa-solid fa-rotate-left"></i>

            <div>
                <strong>Easy Returns</strong>
                <span>Simple & hassle-free returns</span>
            </div>
        </div>


        <div class="trust-item">
            <i class="fa-solid fa-headset"></i>

            <div>
                <strong>24/7 Support</strong>
                <span>We're here to help</span>
            </div>
        </div>

    </div>


    <!-- Bottom -->
    <div class="footer-bottom">

        <p>
            © <%= new Date().getFullYear() %> <b>Velox</b>. All rights reserved.
        </p>

        <div class="bottom-links">
            <a href="#">Privacy</a>
            <a href="#">Terms</a>
            <a href="#">Cookies</a>
        </div>

        <div class="payment-methods">

            <span><i class="fa-brands fa-cc-visa"></i></span>

            <span><i class="fa-brands fa-cc-mastercard"></i></span>

            <span><i class="fa-brands fa-google-pay"></i></span>

            <span><i class="fa-solid fa-money-bill-wave"></i></span>

        </div>

    </div>

</footer>