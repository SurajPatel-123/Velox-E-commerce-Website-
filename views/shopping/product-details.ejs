<%- include("./commonHeader/header") %>
<%- include("./commonHeader/navbar1") %>

<hr>

<% if (!product) { %>
  <div style="text-align: center; padding: 50px;">
    <h2>No product details available.</h2>
    <p>Search Query: "<%= query %>"</p>
  </div>
<% } else { %>

<div class="product-detail-page">

    <div class="product-detail-image">
        <img
            src="<%= product.image %>"
            alt="<%= product.title || product.name %>"
        >
    </div>

    <div class="product-detail-info">

        <h1><%= product.title || product.name %></h1>

        <% if (product.rating) { %>
            <div class="product-rating">
                ⭐ <%= product.rating %>
            </div>
        <% } %>

        <p class="product-category">
            Category: <%= product.category %>
        </p>

        <p class="product-description">
            <%= product.description %>
        </p>

        <div class="product-price">
            ₹<%= product.price ? product.price.toLocaleString("en-IN") : 0 %>
        </div>

        <div class="product-actions">
            <button
                class="cart-btn"
                onclick="addToCart('<%= product._id %>')"
            >
                <i class="fa-solid fa-cart-shopping"></i>
                Add to Cart
            </button>

            <button
                class="buy-btn"
                onclick="buyNow()"
            >
                Buy Now
            </button>
          <!-- <button class="wishlist-btn" onclick="addToWishlist('<%= product._id %>', this)">
  <i class="fa-regular fa-heart wishlist-icon"></i>
</button> -->
  <!-- 🔴 WISHLIST BUTTON (POSITIONED ON IMAGE) -->
                        <button 
                            type="button" 
                            class="wishlist-icon-btn" 
                           onclick="addToWishlist('<%= product._id %>', this)"
                        >
                            <% if (user && user.wishlist && user.wishlist.includes(product._id)) { %>
                                <i class="fa-solid fa-heart" style="color: #e63946;"></i>
                            <% } else { %>
                                <i class="fa-regular fa-heart"></i>
                            <% } %>
                        </button>
        </div>

    </div>

</div>

<% } %>

<style>
   


.wishlist-icon-btn {
    top: 12px;
    right: 12px;
    background: #ffffff;
    border: 1px solid #eee;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    color: #666;
    cursor: pointer;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
    transition: all 0.2s ease;
    z-index: 10;
    outline: none;
}

.wishlist-icon-btn:hover {
    background: #ffe6e6;
    border-color: #e63946;
}

.wishlist-icon-btn .fa-solid.fa-heart {
    color: #e63946 !important;
    animation: pop 0.3s ease;
}
.product-detail-page {
    width: 90%;
    min-height: 450px;
    padding: 50px;
    display: flex;
    gap: 60px;
    background: #f5f7fa;
}

.product-detail-image {
    width: 50%;
    min-height: 350px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: white;
    border-radius: 12px;
}

.product-detail-image img {
    width: 85%;
    height: 450px;
    object-fit: contain;
}

.product-detail-info {
    width: 50%;
    padding: 20px;
}

.product-detail-info h1 {
    font-size: 32px;
    color: #172b4d;
    margin-bottom: 15px;
}

.product-rating {
    display: inline-block;
    padding: 6px 12px;
    background: #198754;
    color: white;
    border-radius: 5px;
    margin-bottom: 15px;
}

.product-category {
    color: #777;
    font-size: 14px;
}

.product-description {
    color: #555;
    font-size: 16px;
    line-height: 1.7;
    margin-top: 20px;
}

.product-price {
    font-size: 32px;
    font-weight: 700;
    margin-top: 25px;
    color: #111;
}

.product-actions {
    display: flex;
    gap: 15px;
    margin-top: 30px;
}

.cart-btn,
.buy-btn {
    border: none;
    padding: 13px 25px;
    border-radius: 8px;
    font-size: 16px;
    cursor: pointer;
}

.cart-btn {
    background: #03045e;
    color: white;
}

.buy-btn {
    background: #ff9f00;
    color: white;
}

.cart-btn:hover,
.buy-btn:hover {
    opacity: 0.9;
}

@media(max-width: 768px) {
    .product-detail-page {
        flex-direction: column;
        padding: 20px;
        gap: 20px;
    }

    .product-detail-image,
    .product-detail-info {
        width: 100%;
    }
}
</style>

<script>
    function buyNow(){
        window.location.href="/buy";
    }
async function addToCart(productId) {
    try {
        const response = await fetch("/cart/add", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({
                productId: productId,
                quantity: 1
            })
        });

        const data = await response.json();

        if (data.success) {
            alert("Product added to cart");

            if (typeof updateCartCount === "function") {
                updateCartCount();
            }
        } else {
            alert(data.message || "Unable to add product to cart");
        }

    } catch (error) {
        console.error("Add to Cart Error:", error);
        alert("Something went wrong. Unable to add product to cart.");
    }
}

function buyNow(productId) {
    window.location.href = `/shopping/checkout/${productId}`;
}

// 🟢 FIX 1: Removed surrounding single quotes around JSON.stringify
const currentUser = JSON.parse('<%- JSON.stringify(user || null) %>');
async function addToWishlist(productId, btnElement) {
    if (!currentUser) {
        alert("Please login to use Wishlist");
        window.location.href = "/auth/login";
        return;
    }

    const icon = btnElement.querySelector('i');

    try {
        const response = await fetch('/wishlist/add', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ productId: productId })
        });

        const data = await response.json();

        if (response.ok && data.success) {
            // Heart Icon Change To Red Fill
            icon.classList.remove('fa-regular');
            icon.classList.add('fa-solid');
            icon.style.color = '#e63946';

            alert(data.message || "Added to Wishlist!");
        } else {
            alert(data.message || "Could not add to Wishlist.");
        }

    } catch (err) {
        console.error("Wishlist Add Error:", err);
        alert("Server error. Please try again.");
    }
};
