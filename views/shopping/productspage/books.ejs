<%- include("../commonHeader/header") %>
<%- include("../commonHeader/navbar1") %>



<div class="electronics-page">

    <div class="products-header">
        <div>
            <h2>Books</h2>
            <p>Explore the latest Books products</p>
        </div>
        <!-- Trigger Button to Open Modal -->
        <button type="button" class="open-filter-btn" onclick="openFilterModal()">
            <i class="fa-solid fa-sliders"></i> Filters
        </button>
    </div>

    <!-- Filter Popup Modal Overlay -->
    <div id="filterModal" class="filter-modal-overlay">
        <div class="filter-modal-content">
            <div class="modal-header">
                <h3><i class="fa-solid fa-filter"></i> Filter Products</h3>
                <span class="close-btn" onclick="closeFilterModal()">&times;</span>
            </div>

            <div class="modal-body">
                <!-- Price Filters -->
                <div class="filter-group">
                    <h4>Price Range</h4>
                    <div class="price-inputs">
                        <input type="number" id="minPriceInput" placeholder="Min (₹)">
                        <span>to</span>
                        <input type="number" id="maxPriceInput" placeholder="Max (₹)">
                    </div>
                </div>

                <!-- Star Rating Filters -->
                <div class="filter-group">
                    <h4>Minimum Rating</h4>
                    <div class="rating-buttons">
                        <button type="button" class="rating-btn active" data-rating="0" onclick="setRatingFilter(0, this)">All Ratings</button>
                        <button type="button" class="rating-btn" data-rating="4" onclick="setRatingFilter(4, this)">4★ & above</button>
                        <button type="button" class="rating-btn" data-rating="3" onclick="setRatingFilter(3, this)">3★ & above</button>
                        <button type="button" class="rating-btn" data-rating="2" onclick="setRatingFilter(2, this)">2★ & above</button>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="reset-btn" onclick="resetFilters()">Reset All</button>
                <button type="button" class="apply-btn" onclick="applyFilters()">Apply Filters</button>
            </div>
        </div>
    </div>

    <!-- Main Products Grid -->
    <div class="products-container" id="productsContainer">
        <% products.forEach(product => { %>
            <div class="product-card" data-id="<%= product._id %>">
                <a href="/shopping/product/<%= product._id %>" class="product-link">
                    <div class="product-img">
                        <img src="<%= product.image %>" alt="<%= product.title %>">
                    </div>
                    <div class="product-details">
                        <h3><%= product.title %></h3>
                        <p class="description"><%= product.description %></p>
                        <div class="rating">⭐ <%= product.rating %></div>
                        <div class="price">₹<%= product.price.toLocaleString("en-IN") %></div>
                        <p class="category"><%= product.category %></p>
                        <br>
                        <button type="button" class="buy-now-btn" onclick="event.stopPropagation(); buyNow('<%= product._id %>')" style="cursor: pointer; outline: none; border: none; border-radius: 10px; font-size: 16px; height: 35px; gap: 5px; width: 110px; display: flex; align-items: center; justify-content: center; background-color: #03045e; color: white;">
                            <i class="fa-solid fa-cart-shopping"></i>Buy Now
                        </button>
                        <button type="button" class="wishlist-icon-btn" onclick="addToWishlist('<%= product._id %>', this)">
                            <% if (user && user.wishlist && user.wishlist.includes(product._id)) { %>
                                <i class="fa-solid fa-heart" style="color: #e63946;"></i>
                            <% } else { %>
                                <i class="fa-regular fa-heart"></i>
                            <% } %>
                        </button>                   
                    </div>
                </a>
            </div>
        <% }) %>
    </div>
</div>

<%- include("../commonHeader/footer") %>
<style>
/* =========================
   GLOBAL FIX (overflow)
========================= */
   /* Header Layout Fix for Filter Button */
.products-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
}
    .open-filter-btn {
    background: #03045e;
    color: #ffffff;
    border: none;
    padding: 10px 20px;
    font-size: 15px;
    font-weight: 600;
    border-radius: 6px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: background 0.2s ease;
}

.open-filter-btn:hover {
    background: #0077b6;
}

/* Modal Background Overlay */
.filter-modal-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.5);
    z-index: 1000;
    justify-content: center;
    align-items: center;
}

/* Modal Content Card */
.filter-modal-content {
    background: #ffffff;
    width: 90%;
    max-width: 480px;
    border-radius: 12px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
    overflow: hidden;
    animation: fadeIn 0.25s ease-out;
}

@keyframes fadeIn {
    from { opacity: 0; transform: translateY(-20px); }
    to { opacity: 1; transform: translateY(0); }
}

.modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 20px;
    background: #f8f9fa;
    border-bottom: 1px solid #eee;
}

.modal-header h3 {
    margin: 0;
    font-size: 18px;
    color: #172b4d;
}

.close-btn {
    font-size: 24px;
    font-weight: bold;
    color: #666;
    cursor: pointer;
}

.close-btn:hover {
    color: #000;
}

.modal-body {
    padding: 20px;
}

.filter-group {
    margin-bottom: 22px;
}

.filter-group h4 {
    margin: 0 0 10px;
    font-size: 15px;
    color: #333;
}

.price-inputs {
    display: flex;
    align-items: center;
    gap: 10px;
}

.price-inputs input {
    width: 100%;
    padding: 8px 12px;
    border: 1px solid #ccc;
    border-radius: 6px;
    font-size: 14px;
    outline: none;
}

.rating-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.rating-btn {
    background: #f0f2f5;
    border: 1px solid #ddd;
    padding: 8px 14px;
    border-radius: 20px;
    font-size: 13px;
    cursor: pointer;
    transition: all 0.2s ease;
}

.rating-btn.active,
.rating-btn:hover {
    background: #03045e;
    color: #ffffff;
    border-color: #03045e;
}

.modal-footer {
    display: flex;
    justify-content: space-between;
    padding: 16px 20px;
    background: #f8f9fa;
    border-top: 1px solid #eee;
}

.reset-btn {
    background: transparent;
    border: 1px solid #ccc;
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
}

.apply-btn {
    background: #198754;
    color: white;
    border: none;
    padding: 8px 20px;
    border-radius: 6px;
    font-weight: 600;
    cursor: pointer;
}

.apply-btn:hover {
    background: #146c43;
}
/* =========================
   GLOBAL FIX (overflow)
========================= */
.electronics-page,
.electronics-page * {
    box-sizing: border-box;
}

.wishlist-icon-btn {
    margin-top: -35px;
margin-left: 230px;
    background: #ffffff;
    border: 1px solid #eee;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    color: #666;
    cursor: pointer;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
    transition: all 0.2s ease;
    z-index: 10;
    outline: none;
}

.wishlist-icon-btn:hover {
    background: #ffe6e6;
    border-color: #e63946;
}

.wishlist-icon-btn .fa-solid.fa-heart {
    color: #e63946 !important;
    animation: pop 0.3s ease;
}

/* =========================
   ELECTRONICS PAGE
========================= */

.electronics-page {
    width: 100%;
    max-width: 100vw;
    background: #f5f7fa;
    padding: 5px 10px;
    overflow-x: hidden;
}


/* =========================
   PAGE HEADER
========================= */

.products-header {
    margin: 0 0 25px 10px;
}

.products-header h2 {
    margin: 0;
    font-size: 30px;
    font-weight: 700;
    color: #172b4d;
}

.products-header p {
    margin: 7px 0 0;
    font-size: 15px;
    color: #777;
}

.products-container {
    width: 100%;
    height: fit-content;

    display: grid !important;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 15px;
}


/* =========================
   PRODUCT CARD
========================= */

.product-card {
    width: 312px !important;
    height: auto !important;
margin-left: 0px;
    border-radius: 8px;
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.product-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
}


/* =========================
   PRODUCT LINK
========================= */

.product-link {
    width: 100%;
    height: 100%;

    display: block !important;

    text-decoration: none;
    color: inherit;
}


/* =========================
   PRODUCT IMAGE BOX
========================= */

.product-img {
    width: 100%;
    height: 230px !important;

    padding: 15px;

    display: flex !important;

    align-items: center;
    justify-content: center;

    background: #ffffff;
}


/* =========================
   PRODUCT IMAGE
========================= */

.product-img img {
    width: 100%;
    height: 100%;

    display: block !important;

    object-fit: contain;
}


/* =========================
   PRODUCT DETAILS
========================= */

.product-details {
    width: 100%;

    display: block !important;

    padding: 15px;

    background: #ffffff;
}


/* =========================
   TITLE
========================= */

.electronics-page .product-details h3 {
    margin: 0;

    font-size: 17px;
    font-weight: 600;

    line-height: 1.4;

    color: #172b4d;

    min-height: 48px;
    max-height: 48px;

    overflow: hidden;
}


/* =========================
   DESCRIPTION
========================= */

.electronics-page .product-details .description {
    margin: 8px 0;

    font-size: 13px;
    line-height: 1.4;

    color: #777;

    min-height: 38px;
    max-height: 38px;

    overflow: hidden;
}


/* =========================
   RATING
========================= */

.electronics-page .rating {
    display: inline-block !important;

    padding: 4px 8px;

    background: #198754;

    color: #ffffff;

    border-radius: 4px;

    font-size: 13px;
}


/* =========================
   PRICE
========================= */

.electronics-page .price {
    display: block !important;

    margin-top: 10px;

    font-size: 20px;
    font-weight: 700;

    color: #111111;
}


/* =========================
   CATEGORY
========================= */

.electronics-page .category {
    display: block !important;

    margin: 5px 0 0;

    font-size: 12px;

    color: #888888;
}


/* =========================
   1200px
========================= */

@media (max-width: 1200px) {

    .electronics-page .products-container {
        grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
    }

}


/* =========================
   900px
========================= */

@media (max-width: 900px) {

    .electronics-page {
        padding: 25px 20px;
    }

    .electronics-page .products-container {
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    }

}


/* =========================
   650px
========================= */

@media (max-width: 650px) {

    .electronics-page {
        padding: 20px 12px;
    }

    .electronics-page .products-container {
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;

        gap: 12px;
    }

    .electronics-page .product-img {
        height: 180px !important;
    }

    .electronics-page .product-details {
        padding: 12px;
    }

}


/* =========================
   400px
========================= */

@media (max-width: 400px) {

    .electronics-page .products-container {
        grid-template-columns: 1fr !important;
    }

}
</style>
<script>
    
function buyNow(productId) {
    window.location.href = `/checkout/${productId}`;
}
const currentUser = JSON.parse('<%- JSON.stringify(user || null) %>');
async function addToWishlist(productId, btnElement) {
    if (!currentUser) {
        alert("Please login to use Wishlist");
        window.location.href = "/auth/login";
        return;
    }

    const icon = btnElement.querySelector('i');

    try {
        const response = await fetch('/wishlist/add', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ productId: productId })
        });

        const data = await response.json();

        if (response.ok && data.success) {
            // Heart Icon Change To Red Fill
            icon.classList.remove('fa-regular');
            icon.classList.add('fa-solid');
            icon.style.color = '#e63946';

            alert(data.message || "Added to Wishlist!");
        } else {
            alert(data.message || "Could not add to Wishlist.");
        }

    } catch (err) {
        console.error("Wishlist Add Error:", err);
        alert("Server error. Please try again.");
    }
};
// 1. Pass Products Array into Client JS Memory
const rawProducts = <%- JSON.stringify(products) %>;
let selectedMinRating = 0;

// 2. Modal Toggle Functions
function openFilterModal() {
    document.getElementById('filterModal').style.display = 'flex';
}

function closeFilterModal() {
    document.getElementById('filterModal').style.display = 'none';
}

// Close Modal when clicking outside content area
window.onclick = function(event) {
    const modal = document.getElementById('filterModal');
    if (event.target === modal) {
        closeFilterModal();
    }
};

// 3. Rating Button Active Switcher
function setRatingFilter(rating, btn) {
    selectedMinRating = rating;
    document.querySelectorAll('.rating-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
}

// 4. Apply Filters Logic
function applyFilters() {
    const minPrice = parseFloat(document.getElementById('minPriceInput').value) || 0;
    const maxPrice = parseFloat(document.getElementById('maxPriceInput').value) || Infinity;

    const filteredList = rawProducts.filter(product => {
        const matchesPrice = product.price >= minPrice && product.price <= maxPrice;
        const matchesRating = product.rating >= selectedMinRating;
        return matchesPrice && matchesRating;
    });

    renderFilteredProducts(filteredList);
    closeFilterModal();
}

// 5. Reset Filters
function resetFilters() {
    document.getElementById('minPriceInput').value = '';
    document.getElementById('maxPriceInput').value = '';
    selectedMinRating = 0;
    
    document.querySelectorAll('.rating-btn').forEach((btn, index) => {
        btn.classList.toggle('active', index === 0);
    });

    renderFilteredProducts(rawProducts);
    closeFilterModal();
}

// 6. Grid Renderer
function renderFilteredProducts(productsToDisplay) {
    const container = document.getElementById('productsContainer');
    
    if (productsToDisplay.length === 0) {
        container.innerHTML = `<div style="grid-column: 1/-1; text-align: center; padding: 40px; color: #666; font-size: 18px;">No products match your filter criteria.</div>`;
        return;
    }

    const html = productsToDisplay.map(product => {
        const isWishlisted = currentUser && currentUser.wishlist && currentUser.wishlist.includes(product._id);
        const heartIcon = isWishlisted 
            ? `<i class="fa-solid fa-heart" style="color: #e63946;"></i>` 
            : `<i class="fa-regular fa-heart"></i>`;

        return `
            <div class="product-card">
                <a href="/shopping/product/${product._id}" class="product-link">
                    <div class="product-img">
                        <img src="${product.image}" alt="${product.title}">
                    </div>
                    <div class="product-details">
                        <h3>${product.title}</h3>
                        <p class="description">${product.description}</p>
                        <div class="rating">⭐ ${product.rating}</div>
                        <div class="price">₹${product.price.toLocaleString("en-IN")}</div>
                        <p class="category">${product.category}</p>
                        <br>
                        <button type="button" class="buy-now-btn" onclick="event.stopPropagation(); buyNow('${product._id}')" style="cursor: pointer; outline: none; border: none; border-radius: 10px; font-size: 16px; height: 35px; gap: 5px; width: 110px; display: flex; align-items: center; justify-content: center; background-color: #03045e; color: white;">
                            <i class="fa-solid fa-cart-shopping"></i>Buy Now
                        </button>
                        <button type="button" class="wishlist-icon-btn" onclick="addToWishlist('${product._id}', this)">
                            ${heartIcon}
                        </button>
                    </div>
                </a>
            </div>
        `;
    }).join('');

    container.innerHTML = html;
}
</script>