<%- include("../../shopping/commonHeader/header") %>
<%- include("../../shopping/commonHeader/navbar3") %>
<hr>

<div class="bus-travel-page">

    <!-- HERO HEADER SECTION -->
    <div class="bus-header">
        <h2>🚌 Bus Tickets & Express Travel</h2>
        <p>Book comfortable, safe, and affordable bus journeys to your destination!</p>
    </div>

    <!-- MAIN CONTAINER -->
    <div class="bus-container">

        <% (beaches || products).forEach(bus => { %>
            <div class="bus-card">
                <a href="/travel/product/<%= bus._id %>" class="bus-link">

                    <!-- IMAGE CONTAINER WITH WISHLIST BUTTON -->
                    <div class="bus-img-wrapper">
                        <button 
                            type="button" 
                            class="wishlist-icon-btn" 
                            onclick="event.preventDefault(); event.stopPropagation(); toggleWishlist('<%= bus._id %>', this)"
                            aria-label="Save to Wishlist"
                        >
                            <% if (user && user.wishlist && user.wishlist.includes(bus._id)) { %>
                                <i class="fa-solid fa-heart active-heart"></i>
                            <% } else { %>
                                <i class="fa-regular fa-heart"></i>
                            <% } %>
                        </button>

                        <img src="<%= bus.image %>" alt="<%= bus.title %>" loading="lazy">
                        <span class="badge-bus-type"><%= bus.busType || 'AC Sleeper / Seater' %></span>
                    </div>

                    <!-- CARD DETAILS -->
                    <div class="bus-details">
                        <div class="bus-route">
                            <i class="fa-solid fa-bus-simple"></i> <%= bus.location || bus.route || 'Express Service' %>
                        </div>

                        <h3><%= bus.title %></h3>

                        <p class="description"><%= bus.description %></p>

                        <div class="bus-amenities">
                            <span class="tag"><i class="fa-solid fa-wifi"></i> WiFi</span>
                            <span class="tag"><i class="fa-solid fa-plug"></i> Charging Point</span>
                            <span class="tag"><i class="fa-solid fa-bottle-water"></i> Water</span>
                        </div>

                        <div class="meta-info">
                            <div class="rating">
                                ⭐ <%= bus.rating %> <span class="reviews">(<%= bus.reviewsCount || '80+' %> reviews)</span>
                            </div>
                        </div>

                        <div class="card-footer">
                            <div class="price-wrapper">
                                <span class="price-label">Fare starts at</span>
                                <div class="price">₹<%= bus.price.toLocaleString("en-IN") %></div>
                            </div>

                            <button type="button"
                                class="book-now-btn"
                                onclick="event.preventDefault(); event.stopPropagation(); addToCart('<%= bus._id %>')">  
                                <i class="fa-solid fa-cart-plus"></i> Add to Cart
                            </button>
                        </div>
                    </div>

                </a>
            </div>
        <% }) %>

    </div>

</div>

<%- include("../../shopping/commonHeader/footer") %>

<style>
/* =========================
   GLOBAL RESET
========================= */

.bus-travel-page,
.bus-travel-page * {
    box-sizing: border-box;
}

/* =========================
   PAGE CONTAINER
========================= */

.bus-travel-page {
    width: 100%;
    max-width: 100vw;
    background: #f8fafc;
    padding: 25px 30px;
    overflow-x: hidden;
}

/* =========================
   PAGE HEADER
========================= */

.bus-header {
    margin: 0 0 30px 5px;
}

.bus-header h2 {
    margin: 0;
    font-size: 30px;
    font-weight: 700;
    color: #1e293b;
}

.bus-header p {
    margin: 8px 0 0;
    font-size: 15px;
    color: #0284c7;
}

/* =========================
   GRID CONTAINER
========================= */

.bus-container {
    width: 100%;
    display: grid !important;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
}

/* =========================
   BUS CARD
========================= */

.bus-card {
    width: 100% !important;
    border-radius: 16px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    background: #ffffff;
    border: 1px solid #e2e8f0;
}

.bus-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 28px rgba(2, 132, 199, 0.12);
}

.bus-link {
    width: 100%;
    height: 100%;
    display: flex !important;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
}

/* =========================
   IMAGE & BADGES
========================= */

.bus-img-wrapper {
    width: 100%;
    height: 200px !important;
    position: relative;
    overflow: hidden;
    background: #f1f5f9;
}

.bus-img-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
}

.bus-card:hover .bus-img-wrapper img {
    transform: scale(1.06);
}

.badge-bus-type {
    position: absolute;
    bottom: 12px;
    left: 12px;
    background: rgba(15, 23, 42, 0.8);
    backdrop-filter: blur(4px);
    color: #ffffff;
    font-size: 11px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 20px;
}

/* =========================
   WISHLIST BUTTON
========================= */

.wishlist-icon-btn {
    position: absolute;
    top: 12px;
    right: 12px;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(4px);
    border: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 17px;
    color: #64748b;
    cursor: pointer;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    transition: all 0.2s ease;
    z-index: 10;
    outline: none;
}

.wishlist-icon-btn:hover {
    background: #ffffff;
    color: #e63946;
}

.wishlist-icon-btn .active-heart {
    color: #e63946 !important;
    animation: pop 0.3s ease;
}

@keyframes pop {
    0% { transform: scale(1); }
    50% { transform: scale(1.3); }
    100% { transform: scale(1); }
}

/* =========================
   BUS DETAILS
========================= */

.bus-details {
    width: 100%;
    padding: 18px;
    background: #ffffff;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
}

.bus-route {
    font-size: 12px;
    font-weight: 600;
    color: #0284c7;
    margin-bottom: 6px;
    display: flex;
    align-items: center;
    gap: 6px;
}

.bus-travel-page .bus-details h3 {
    margin: 0;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.3;
    color: #0f172a;
    min-height: 42px;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.bus-travel-page .bus-details .description {
    margin: 6px 0 10px 0;
    font-size: 13px;
    line-height: 1.4;
    color: #64748b;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 36px;
}

/* AMENITIES TAGS */
.bus-amenities {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 12px;
}

.bus-amenities .tag {
    font-size: 10px;
    background: #f1f5f9;
    color: #475569;
    padding: 3px 8px;
    border-radius: 6px;
    font-weight: 500;
}

.meta-info {
    margin-bottom: 14px;
}

.rating {
    font-size: 13px;
    font-weight: 600;
    color: #d97706;
}

.reviews {
    color: #94a3b8;
    font-weight: 400;
    font-size: 12px;
}

/* =========================
   FOOTER & BUTTON
========================= */

.card-footer {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding-top: 12px;
    border-top: 1px solid #f1f5f9;
}

.price-wrapper {
    display: flex;
    flex-direction: column;
}

.price-label {
    font-size: 11px;
    color: #94a3b8;
}

.price {
    font-size: 18px;
    font-weight: 800;
    color: #0284c7;
}

.book-now-btn {
    cursor: pointer;
    outline: none;
    border: none;
    border-radius: 10px;
    font-size: 13px;
    font-weight: 600;
    padding: 0 14px;
    height: 38px;
    gap: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #0284c7;
    color: white;
    transition: background-color 0.2s ease;
}

.book-now-btn:hover {
    background-color: #0369a1;
}

/* =========================
   RESPONSIVE BREAKPOINTS
========================= */

@media (max-width: 1200px) {
    .bus-travel-page .bus-container {
        grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
    }
}

@media (max-width: 850px) {
    .bus-travel-page {
        padding: 15px;
    }

    .bus-travel-page .bus-container {
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        gap: 16px;
    }
}

@media (max-width: 480px) {
    .bus-travel-page .bus-container {
        grid-template-columns: 1fr !important;
    }

    .bus-img-wrapper {
        height: 180px !important;
    }
}
</style>

<script>
const currentUser = JSON.parse('<%- JSON.stringify(user || null) %>');

// Travel Cart me Item add karke Cart Page redirect karne ke liye function
async function addToCart(busId) {
    try {
        const response = await fetch('/travel/veloxTravel/travelCart/add', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ productId: busId, quantity: 1 })
        });

        if (response.ok) {
            window.location.href = "/travel/veloxTravel/travelCart";
        } else {
            const data = await response.json().catch(() => ({}));
            alert(data.message || "Failed to add ticket to cart. Please try again.");
        }
    } catch (err) {
        console.error("Cart error:", err);
        alert("A network error occurred while adding to cart.");
    }
}

async function toggleWishlist(busId, btnElement) {
    if (!currentUser) {
        alert("Please login to save buses.");
        window.location.href = "/auth/login";
        return;
    }

    const icon = btnElement.querySelector('i');
    const isCurrentlyInWishlist = icon.classList.contains('fa-solid');

    try {
        const endpoint = isCurrentlyInWishlist ? '/wishlist/remove' : '/wishlist/add';
        const response = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ productId: busId })
        });

        const data = await response.json();

        if (response.ok && data.success) {
            if (isCurrentlyInWishlist) {
                icon.className = 'fa-regular fa-heart';
            } else {
                icon.className = 'fa-solid fa-heart active-heart';
            }
        } else {
            alert(data.message || "Failed to update wishlist.");
        }
    } catch (err) {
        console.error("Wishlist Toggle Error:", err);
        alert("Server connection error. Please try again.");
    }
}
</script>