<%- include("../shopping/commonheader/header") %>
<%- include("../shopping/commonheader/navbar2") %>

<% 
  // Safe Variable Declaration: Prevents "products is not defined" error if variable is missing from router
  const wishlistProducts = (typeof products !== 'undefined' && Array.isArray(products)) ? products : []; 
%>

<div style="max-width: 1200px; margin: 30px auto; padding: 0 20px;">
  <h2>My Wishlist (<span id="wishlist-count"><%= wishlistProducts.length %></span>)</h2>

  <% if (wishlistProducts.length === 0) { %>
    <div id="empty-msg" style="text-align: center; padding: 50px;">
      <p style="color: #666;">Your wishlist is empty!</p>
      <a href="/grocery" style="color: #198754; font-weight: bold; text-decoration: none;">Continue Shopping</a>
    </div>
  <% } else { %>
    <div id="wishlist-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 20px; margin-top: 20px;">
      <% wishlistProducts.forEach(product => { %>
        <div id="product-card-<%= product._id %>" style="border: 1px solid #ddd; border-radius: 8px; padding: 15px; background: white; transition: all 0.3s ease;">
          <img src="<%= product.image %>" alt="<%= product.title %>" style="width: 100%; height: 180px; object-fit: contain;">
          
          <p style="font-weight: bold; background-color: #198754; color: #fff; height: 25px; display: flex; align-items: center; justify-content: center; width: 55px; border-radius: 5px; margin: 10px 0 5px 0; font-size: 13px;">
            ⭐ <%= product.rating || '4.5' %>
          </p>

          <h4 style="margin: 8px 0; font-size: 16px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= product.title %></h4>
          <p style="font-weight: bold; color: #111; margin-bottom: 10px;">₹<%= product.price ? product.price.toLocaleString("en-IN") : '0' %></p>

          <div class="product-card-actions">
            <!-- 1. Buy Now Button -->
            <a href="/grocery/checkout/<%= product._id %>" class="btn buy-now-btn">
              Buy Now
            </a>

            <!-- 2. Remove Button -->
            <button class="btn remove-btn" onclick="removeFromWishlist('<%= product._id %>')">
              <i class="fa-solid fa-trash"></i> Remove
            </button>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<style>
.product-card-actions {
  display: flex;
  gap: 10px;
  margin-top: 15px;
  align-items: center;
}

.buy-now-btn {
  background-color: #ff9f00; /* Flipkart style orange */
  color: white;
  padding: 8px 12px;
  border-radius: 6px;
  text-decoration: none;
  font-weight: 600;
  font-size: 14px;
  display: inline-block;
  text-align: center;
  flex: 1;
  transition: background 0.2s ease;
}

.buy-now-btn:hover {
  background-color: #e68f00;
}

.remove-btn {
  background-color: #dc3545; /* Red color */
  color: white;
  border: none;
  padding: 4px 8px;
  border-radius: 6px;
  cursor: pointer;
  font-size: 13px;
  flex: 1;
  transition: background 0.2s ease;
}

.remove-btn:hover {
  background-color: #c82333;
}
</style>

<script>
  function checkoutCart() {
    window.location.href = "/grocery/checkout";
}
async function removeFromWishlist(productId) {
  if (!confirm("Are you sure you want to remove this item?")) return;

  try {
      // API Endpoint URL matching Express Router mapping
      const response = await fetch('/wishlist/remove', {
          method: 'POST',
          headers: {
              'Content-Type': 'application/json'
          },
          body: JSON.stringify({ productId: productId })
      });

      const data = await response.json();

      if (response.ok && data.success) {
          // Dynamic Element Removal
          const card = document.getElementById(`product-card-${productId}`);
          if (card) {
              card.remove();
          }

          // Count Update Logic
          const countSpan = document.getElementById('wishlist-count');
          if (countSpan) {
              let currentCount = parseInt(countSpan.innerText) || 0;
              currentCount = Math.max(0, currentCount - 1);
              countSpan.innerText = currentCount;

              // If all items removed, reload page to show Empty State
              if (currentCount === 0) {
                  window.location.reload();
              }
          }
      } else {
          alert(data.message || "Failed to remove product from wishlist");
      }

  } catch (err) {
      console.error("Remove Wishlist Error:", err);
      alert("Server error. Please try again.");
  }
}
</script>

<!-- FIXED: Correct path to shopping/commonheader folder for footer -->
<%- include("../shopping/commonheader/footer") %>