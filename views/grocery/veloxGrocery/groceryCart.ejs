<%- include("../../shopping/commonHeader/header") %>
<%- include("../../shopping/commonHeader/navbar2") %>

<div class="cart-page">

    <!-- PAGE HEADER -->
    <div class="cart-title">
        <div>
            <h1>My Grocery Cart</h1>
            <p><span id="total-items-count"><%= totalItems %></span> item(s) in your cart</p>
        </div>
        <a href="/grocery" class="continue-shopping">
            <i class="fa-solid fa-arrow-left"></i> Continue Shopping
        </a>
    </div>

    <% if (cart.length === 0) { %>
        <!-- EMPTY CART STATE -->
        <div class="empty-cart" id="empty-cart-container">
            <i class="fa-solid fa-cart-shopping"></i>
            <h2>Your Grocery Cart is Empty</h2>
            <p>Fresh fruits, vegetables, and daily essentials are waiting for you.</p>
            <a href="/grocery">Shop Now</a>
        </div>
    <% } else { %>

    <!-- MAIN CART LAYOUT -->
    <div class="cart-layout" id="cart-main-layout">

        <!-- LEFT SIDE: ITEM LIST -->
        <div class="cart-left">
            <% cart.forEach(item => { %>
                <div class="cart-item" id="item-<%= item.product._id %>">
                    
                    <div class="cart-image">
                        <img src="<%= item.product.image %>" alt="<%= item.product.title %>">
                    </div>

                    <div class="cart-details">
                        <h2><%= item.product.title %></h2>
                        <p class="category"><%= item.product.category %></p>
                        
                        <div class="rating">
                            ⭐ <%= item.product.rating %>
                        </div>

                        <h3>₹<span id="price-<%= item.product._id %>"><%= item.product.price.toLocaleString("en-IN") %></span></h3>

                        <!-- QUANTITY CONTROL -->
                        <div class="quantity-box">
                            <button type="button" onclick="updateQuantity('<%= item.product._id %>', 'decrease')" aria-label="Decrease quantity">-</button>
                            <span id="qty-<%= item.product._id %>"><%= item.quantity %></span>
                            <button type="button" onclick="updateQuantity('<%= item.product._id %>', 'increase')" aria-label="Increase quantity">+</button>
                        </div>

                        <!-- ACTION BUTTONS -->
                        <div class="cart-buttons">
                            <button type="button" class="remove-btn" onclick="removeFromCart('<%= item.product._id %>')">
                                <i class="fa-solid fa-trash"></i> Remove
                            </button>
                            <button type="button" class="save-btn">
                                <i class="fa-regular fa-heart"></i> Save For Later
                            </button>
                        </div>
                    </div>

                    <!-- TOTAL PRICE FOR THIS ITEM -->
                    <div class="item-total">
                        ₹<span id="item-total-<%= item.product._id %>"><%= (item.product.price * item.quantity).toLocaleString("en-IN") %></span>
                    </div>

                </div>
            <% }) %>
        </div>

        <!-- RIGHT SIDE: SUMMARY CARD -->
        <div class="cart-right">
            <div class="summary-card">
                <h2>Price Details</h2>
                <hr>

                <div class="summary-row">
                    <span>Price (<span id="summary-items-count"><%= totalItems %></span> Items)</span>
                    <span>₹<span id="subtotal-val"><%= subtotal.toLocaleString("en-IN") %></span></span>
                </div>

                <div class="summary-row">
                    <span>Delivery Charges</span>
                    <span id="delivery-val">
                        <% if (deliveryFee === 0) { %>
                            <span style="color:#198754; font-weight:600;">FREE</span>
                        <% } else { %>
                            ₹<%= deliveryFee %>
                        <% } %>
                    </span>
                </div>

                <div class="summary-row">
                    <span>Platform Fee</span>
                    <span>₹0</span>
                </div>

                <hr>

                <div class="summary-total">
                    <span>Total Amount</span>
                    <span>₹<span id="total-val"><%= total.toLocaleString("en-IN") %></span></span>
                </div>

                <!-- CHECKOUT BUTTON -->
                <button type="button" class="checkout-btn" onclick="checkoutCart()">
                    Proceed to Checkout
                </button>

                <button type="button" class="clear-cart-btn" onclick="clearCart()">
                    Clear Cart
                </button>
            </div>
        </div>

    </div>
    <% } %>

</div>

<!-- CSS STYLING -->
<style>
body {
    background: #f1f3f6;
}

.cart-page {
    width: 95%;
    max-width: 1450px;
    margin: 25px auto;
}

.cart-title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}

.cart-title h1 {
    font-size: 32px;
    color: #212121;
    margin-bottom: 5px;
}

.cart-title p {
    color: #666;
    font-size: 15px;
}

.continue-shopping {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #198754;
    color: #fff;
    padding: 11px 22px;
    text-decoration: none;
    border-radius: 6px;
    transition: all 0.3s ease;
    font-weight: 600;
}

.continue-shopping:hover {
    background: #146c43;
    color: #fff;
    box-shadow: 0 4px 12px rgba(25, 135, 84, 0.2);
}

.cart-layout {
    display: grid;
    grid-template-columns: 2fr 360px;
    gap: 25px;
}

.cart-left {
    display: flex;
    flex-direction: column;
    gap: 18px;
}

.cart-item {
    background: #fff;
    border-radius: 10px;
    padding: 20px;
    display: flex;
    gap: 20px;
    align-items: center;
    box-shadow: 0 2px 10px rgba(0,0,0,.08);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.cart-item:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(0,0,0,.12);
}

.cart-image {
    width: 150px;
    height: 150px;
    display: flex;
    justify-content: center;
    align-items: center;
    background: #fafafa;
    border-radius: 8px;
    padding: 8px;
    flex-shrink: 0;
}

.cart-image img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
}

.cart-details {
    flex: 1;
}

.cart-details h2 {
    font-size: 20px;
    color: #222;
    margin-bottom: 6px;
}

.category {
    color: #198754;
    font-weight: 600;
    font-size: 14px;
    margin-bottom: 8px;
}

.rating {
    display: inline-block;
    background: #198754;
    color: #fff;
    padding: 3px 8px;
    border-radius: 4px;
    font-size: 12px;
    margin-bottom: 12px;
}

.cart-details h3 {
    font-size: 22px;
    color: #111;
    margin-bottom: 14px;
}

.quantity-box {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 15px;
}

.quantity-box button {
    width: 34px;
    height: 34px;
    border: none;
    background: #e8f5e9;
    color: #198754;
    border-radius: 50%;
    cursor: pointer;
    font-size: 18px;
    font-weight: bold;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
}

.quantity-box button:hover {
    background: #198754;
    color: #fff;
}

.quantity-box span {
    font-size: 18px;
    font-weight: bold;
    width: 25px;
    text-align: center;
}

.cart-buttons {
    display: flex;
    gap: 10px;
}

.remove-btn,
.save-btn {
    border: none;
    cursor: pointer;
    padding: 8px 14px;
    border-radius: 6px;
    font-weight: 600;
    font-size: 13px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: background 0.2s ease, color 0.2s ease;
}

.remove-btn {
    background: #fff0f0;
    color: #dc3545;
}

.remove-btn:hover {
    background: #dc3545;
    color: #fff;
}

.save-btn {
    background: #f8f9fa;
    border: 1px solid #ddd;
    color: #555;
}

.save-btn:hover {
    background: #ececec;
}

.item-total {
    font-size: 24px;
    font-weight: bold;
    color: #198754;
    min-width: 120px;
    text-align: right;
}

.cart-right {
    position: sticky;
    top: 20px;
    height: fit-content;
}

.summary-card {
    background: #fff;
    border-radius: 10px;
    padding: 22px;
    box-shadow: 0 2px 10px rgba(0,0,0,.08);
}

.summary-card h2 {
    font-size: 22px;
    margin-bottom: 15px;
    color: #222;
}

.summary-card hr {
    border: none;
    border-top: 1px solid #e5e5e5;
    margin: 15px 0;
}

.summary-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 12px 0;
    font-size: 15px;
    color: #444;
}

.summary-total {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 20px;
    font-weight: bold;
    color: #111;
    margin: 18px 0;
}

.checkout-btn {
    width: 100%;
    height: 48px;
    border: none;
    border-radius: 6px;
    background: #198754;
    color: #fff;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.3s ease, box-shadow 0.3s ease;
}

.checkout-btn:hover {
    background: #146c43;
    box-shadow: 0 4px 12px rgba(25, 135, 84, 0.25);
}

.clear-cart-btn {
    width: 100%;
    height: 42px;
    border: 1px solid #198754;
    border-radius: 6px;
    background-color: transparent;
    color: #198754;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    margin-top: 12px;
    transition: all 0.3s ease;
}

.clear-cart-btn:hover {
    background: #dc3545;
    border-color: #dc3545;
    color: #fff;
}

.empty-cart {
    width: 100%;
    background: #fff;
    border-radius: 10px;
    padding: 70px 20px;
    text-align: center;
    box-shadow: 0 2px 10px rgba(0,0,0,.08);
}

.empty-cart i {
    font-size: 80px;
    color: #198754;
    margin-bottom: 20px;
}

.empty-cart h2 {
    font-size: 28px;
    margin-bottom: 10px;
    color: #222;
}

.empty-cart p {
    color: #666;
    font-size: 15px;
    margin-bottom: 25px;
}

.empty-cart a {
    display: inline-block;
    background: #198754;
    color: #fff;
    text-decoration: none;
    padding: 12px 28px;
    border-radius: 6px;
    font-weight: 600;
    transition: background 0.3s ease;
}

.empty-cart a:hover {
    background: #146c43;
}

@media(max-width: 1100px) {
    .cart-layout {
        grid-template-columns: 1fr;
    }
    .cart-right {
        position: static;
    }
}

@media(max-width: 768px) {
    .cart-title {
        flex-direction: column;
        align-items: flex-start;
        gap: 15px;
    }
    .cart-item {
        flex-direction: column;
        align-items: flex-start;
    }
    .cart-image {
        width: 100%;
        height: 200px;
    }
    .item-total {
        text-align: left;
        margin-top: 10px;
        font-size: 20px;
    }
    .cart-buttons {
        width: 100%;
    }
    .remove-btn,
    .save-btn {
        flex: 1;
        justify-content: center;
    }
}
</style>

<!-- JAVASCRIPT ACTIONS -->
<script>
function checkoutCart() {
    window.location.href = "/grocery/checkout";
}

async function updateQuantity(productId, action) {
    try {
        const response = await fetch("/groceryCart/update", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ productId, action })
        });

        if (response.ok) {
            location.reload();
        } else {
            alert("Could not update item quantity.");
        }
    } catch (err) {
        console.error(err);
        alert("Something went wrong!");
    }
}

async function removeFromCart(productId) {
    try {
        const response = await fetch("/groceryCart/remove", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ productId })
        });

        if (response.ok) {
            location.reload();
        } else {
            alert("Could not remove item.");
        }
    } catch (err) {
        console.error(err);
        alert("Something went wrong!");
    }
}

async function clearCart() {
    if (!confirm("Are you sure you want to clear your grocery cart?")) return;

    try {
        const response = await fetch("/groceryCart/clear", {
            method: "POST"
        });

        if (response.ok) {
            location.reload();
        } else {
            alert("Could not clear cart.");
        }
    } catch (err) {
        console.error(err);
        alert("Something went wrong!");
    }
}
</script>

<%- include("../../shopping/commonHeader/footer") %>