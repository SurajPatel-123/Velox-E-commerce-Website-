<%- include("../../shopping/commonHeader/header") %>
<%- include("../../shopping/commonHeader/navbar2") %>
<hr>

<div class="electronics-page">

    <div class="products-header">
        <h2>Fruits & Vegetables</h2>
        <p>Explore the latest Fruits & products</p>
    </div>

    <div class="products-container">

        <% products.forEach(product => { %>

            <div class="product-card">

                <a
                    href="/grocery/product/<%= product._id %>"
                    class="product-link"
                >

                    <div class="product-img">
                        <!-- 🔴 WISHLIST BUTTON (POSITIONED ON IMAGE) -->
                        <button 
                            type="button" 
                            class="wishlist-icon-btn" 
                            onclick="event.preventDefault(); event.stopPropagation(); addToWishlist('<%= product._id %>', this)"
                        >
                            <% if (user && user.wishlist && user.wishlist.includes(product._id)) { %>
                                <i class="fa-solid fa-heart" style="color: #e63946;"></i>
                            <% } else { %>
                                <i class="fa-regular fa-heart"></i>
                            <% } %>
                        </button>

                        <img
                            src="<%= product.image %>"
                            alt="<%= product.title %>"
                        >
                    </div>

                    <div class="product-details">

                        <h3>
                            <%= product.title %>
                        </h3>

                        <p class="description">
                            <%= product.description %>
                        </p>

                        <div class="rating">
                            ⭐ <%= product.rating %>
                        </div>

                        <div class="price">
                            ₹<%= product.price.toLocaleString("en-IN") %>
                        </div>

                        <p class="category">
                            <%= product.category %>
                        </p>
                        <br>
                        <button type="button"
                            class="buy-now-btn"
                            onclick="event.preventDefault(); event.stopPropagation(); buyNow('<%= product._id %>')"  
                            style="cursor: pointer; outline: none; border: none; border-radius: 10px; font-size: 16px; height: 35px; gap: 5px; width: 110px; display: flex; align-items: center; justify-content: center; background-color: #198754; color: white;">  
                            <i class="fa-solid fa-cart-shopping"></i>Buy Now
                        </button>
                    </div>

                </a>

            </div>

        <% }) %>

    </div>

</div>

<%- include("../../shopping/commonHeader/footer") %>

<style>
/* =========================
   GLOBAL FIX (overflow)
========================= */

.electronics-page,
.electronics-page * {
    box-sizing: border-box;
}

/* =========================
   ELECTRONICS PAGE
========================= */

.electronics-page {
    width: 100%;
    max-width: 100vw;
    background: #f5f7fa;
    padding: 15px 20px;
    overflow-x: hidden;
}

/* =========================
   PAGE HEADER
========================= */

.products-header {
    margin: 0 0 25px 10px;
}

.products-header h2 {
    margin: 0;
    font-size: 30px;
    font-weight: 700;
    color: #172b4d;
}

.products-header p {
    margin: 7px 0 0;
    font-size: 15px;
    color: #777;
}

.products-container {
    width: 100%;
    height: fit-content;

    display: grid !important;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
}

/* =========================
   PRODUCT CARD
========================= */

.product-card {
    width: 100% !important;
    height: auto !important;
    border-radius: 8px;
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    position: relative;
    background: #ffffff;
}

.product-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
}

/* =========================
   PRODUCT LINK
========================= */

.product-link {
    width: 100%;
    height: 100%;

    display: block !important;

    text-decoration: none;
    color: inherit;
}

/* =========================
   PRODUCT IMAGE BOX
========================= */

.product-img {
    width: 100%;
    height: 230px !important;

    padding: 15px;

    display: flex !important;

    align-items: center;
    justify-content: center;

    background: #ffffff;
    position: relative; /* Heart Icon positioning */
}

/* =========================
   WISHLIST BUTTON (HEART)
========================= */

.wishlist-icon-btn {
    position: absolute;
    top: 12px;
    right: 12px;
    background: #ffffff;
    border: 1px solid #eee;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    color: #666;
    cursor: pointer;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
    transition: all 0.2s ease;
    z-index: 10;
    outline: none;
}

.wishlist-icon-btn:hover {
    background: #ffe6e6;
    border-color: #e63946;
}

.wishlist-icon-btn .fa-solid.fa-heart {
    color: #e63946 !important;
    animation: pop 0.3s ease;
}

@keyframes pop {
    0% { transform: scale(1); }
    50% { transform: scale(1.3); }
    100% { transform: scale(1); }
}

/* =========================
   PRODUCT IMAGE
========================= */

.product-img img {
    width: 100%;
    height: 100%;

    display: block !important;

    object-fit: contain;
}

/* =========================
   PRODUCT DETAILS
========================= */

.product-details {
    width: 100%;

    display: block !important;

    padding: 15px;

    background: #ffffff;
}

/* =========================
   TITLE
========================= */

.electronics-page .product-details h3 {
    margin: 0;

    font-size: 17px;
    font-weight: 600;

    line-height: 1.4;

    color: #172b4d;

    min-height: 48px;
    max-height: 48px;

    overflow: hidden;
}

/* =========================
   DESCRIPTION
========================= */

.electronics-page .product-details .description {
    margin: 8px 0;

    font-size: 13px;
    line-height: 1.4;

    color: #777;

    min-height: 38px;
    max-height: 38px;

    overflow: hidden;
}

/* =========================
   RATING
========================= */

.electronics-page .rating {
    display: inline-block !important;

    padding: 4px 8px;

    background: #198754;

    color: #ffffff;

    border-radius: 4px;

    font-size: 13px;
}

/* =========================
   PRICE
========================= */

.electronics-page .price {
    display: block !important;

    margin-top: 10px;

    font-size: 20px;
    font-weight: 700;

    color: #111111;
}

/* =========================
   CATEGORY
========================= */

.electronics-page .category {
    display: block !important;

    margin: 5px 0 0;

    font-size: 12px;

    color: #888888;
}

/* =========================
   MEDIA QUERIES
========================= */

@media (max-width: 1200px) {
    .electronics-page .products-container {
        grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
    }
}

@media (max-width: 900px) {
    .electronics-page {
        padding: 20px 15px;
    }

    .electronics-page .products-container {
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    }
}

@media (max-width: 650px) {
    .electronics-page {
        padding: 15px 10px;
    }

    .electronics-page .products-container {
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        gap: 12px;
    }

    .electronics-page .product-img {
        height: 180px !important;
    }

    .electronics-page .product-details {
        padding: 12px;
    }
}

@media (max-width: 400px) {
    .electronics-page .products-container {
        grid-template-columns: 1fr !important;
    }
}
</style>

<script>
// Safely pass session user
const currentUser = JSON.parse('<%- JSON.stringify(user || null) %>');

function buyNow(productId) {
    window.location.href = `/grocery/checkout/${productId}`;
}

async function addToWishlist(productId, btnElement) {
    if (!currentUser) {
        alert("Please login to use Wishlist");
        window.location.href = "/auth/login";
        return;
    }

    const icon = btnElement.querySelector('i');

    try {
        const response = await fetch('/wishlist/add', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ productId: productId })
        });

        const data = await response.json();

        if (response.ok && data.success) {
            // Heart Icon Change To Red Fill
            icon.classList.remove('fa-regular');
            icon.classList.add('fa-solid');
            icon.style.color = '#e63946';

            alert(data.message || "Added to Wishlist!");
        } else {
            alert(data.message || "Could not add to Wishlist.");
        }

    } catch (err) {
        console.error("Wishlist Add Error:", err);
        alert("Server error. Please try again.");
    }
}
</script>