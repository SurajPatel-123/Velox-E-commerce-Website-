<%- include("./shopping/commonHeader/header") %>

<div class="order-success-container">
    <div class="success-card">
        <div class="icon-box">
            <i class="fa-solid fa-circle-check"></i>
        </div>
        <h1>Order Placed Successfully!</h1>
        <p class="subtitle">Thank you for your purchase. Your order has been received.</p>

        <div class="order-details">
            <div class="detail-row">
                <span>Order ID:</span>
                <strong>#<%= orderId %></strong>
            </div>
            <div class="detail-row">
                <span>Date:</span>
                <strong><%= orderDate %></strong>
            </div>
        </div>

        <hr class="divider">

        <h3>Order Summary</h3>
        <div class="items-list">
            <% items.forEach(item => { %>
                <div class="item-row">
                    <% if (item.image) { %>
                        <img src="<%= item.image %>" alt="<%= item.title %>">
                    <% } %>
                    <div class="item-info">
                        <h4><%= item.title %></h4>
                        <p>Qty: <%= item.quantity %> × ₹<%= item.price.toLocaleString("en-IN") %></p>
                    </div>
                    <div class="item-price">
                        ₹<%= (item.price * item.quantity).toLocaleString("en-IN") %>
                    </div>
                </div>
            <% }) %>
        </div>

        <hr class="divider">

        <div class="total-row">
            <span>Total Paid:</span>
            <span class="total-amount">₹<%= totalAmount.toLocaleString("en-IN") %></span>
        </div>

        <div class="action-buttons">
            <a href="/" class="btn btn-primary">Continue Shopping</a>
        </div>
    </div>
</div>

<style>
.order-success-container {
    max-width: 650px;
    margin: 40px auto;
    padding: 20px;
}

.success-card {
    background: #ffffff;
    padding: 35px;
    border-radius: 12px;
    box-shadow: 0 4px 16px rgba(0,0,0,0.08);
    text-align: center;
}

.icon-box i {
    font-size: 60px;
    color: #2ec4b6;
    margin-bottom: 15px;
}

.success-card h1 {
    font-size: 24px;
    color: #03045e;
    margin-bottom: 8px;
}

.subtitle {
    color: #6c757d;
    margin-bottom: 25px;
}

.order-details {
    background: #f8f9fa;
    padding: 15px 20px;
    border-radius: 8px;
    margin-bottom: 20px;
}

.detail-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 8px;
    color: #495057;
}

.detail-row:last-child {
    margin-bottom: 0;
}

.divider {
    border: none;
    border-top: 1px dashed #dee2e6;
    margin: 20px 0;
}

.items-list {
    text-align: left;
}

.item-row {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 15px;
}

.item-row img {
    width: 60px;
    height: 60px;
    object-fit: cover;
    border-radius: 6px;
}

.item-info {
    flex-grow: 1;
}

.item-info h4 {
    margin: 0 0 5px 0;
    font-size: 15px;
    color: #172b4d;
}

.item-info p {
    margin: 0;
    font-size: 13px;
    color: #6c757d;
}

.item-price {
    font-weight: bold;
    color: #172b4d;
}

.total-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 18px;
    font-weight: bold;
    color: #172b4d;
    margin-bottom: 25px;
}

.total-amount {
    color: #03045e;
    font-size: 22px;
}

.action-buttons {
    display: flex;
    justify-content: center;
    gap: 15px;
}

.btn {
    padding: 12px 25px;
    border-radius: 6px;
    text-decoration: none;
    font-weight: bold;
    transition: background 0.2s;
}

.btn-primary {
    background-color: #03045e;
    color: #ffffff;
}

.btn-primary:hover {
    background-color: #172b4d;
}
</style>

<%- include("./shopping/commonHeader/footer") %>