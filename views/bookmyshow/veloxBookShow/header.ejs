<%- include('../../shopping/commonHeader/header') %>
<%- include("../../shopping/commonHeader/navbar4") %>

<!-- BOOKMYSHOW BODY START -->
<div class="bms-page">

    <!-- HERO SECTION -->
    <section class="bms-hero">
        <div class="bms-hero-content">
            <span class="bms-badge">
                <i class="fa-solid fa-ticket"></i>
                Entertainment Unlimited
            </span>

            <h1>
                Book Movies,
                <br>
                <span>Events & Shows.</span>
            </h1>

            <p>
                Experience the best in entertainment! Book tickets for movies, live concerts, comedy shows, sports, and much more.
            </p>

            <div class="bms-buttons">
                <a href="#bms-products" class="bms-primary-btn">
                    Explore Events
                    <i class="fa-solid fa-arrow-right"></i>
                </a>
                <a href="#bms-categories" class="bms-secondary-btn">
                    Browse Categories
                </a>
            </div>
        </div>

        <div class="bms-hero-visual">
            <div class="bms-globe">
                <i class="fa-solid fa-film"></i>
            </div>

            <div class="bms-float-card card-one">
                <i class="fa-solid fa-clapperboard"></i>
                <div>
                    <strong>Movies</strong>
                    <small>Latest blockbusters</small>
                </div>
            </div>

            <div class="bms-float-card card-two">
                <i class="fa-solid fa-masks-theater"></i>
                <div>
                    <strong>Live Shows</strong>
                    <small>Best experiences</small>
                </div>
            </div>
        </div>
    </section>

    <!-- QUICK SERVICES / HIGHLIGHTS -->
    <section class="bms-services">
        <div class="bms-service">
            <div class="service-icon">
                <i class="fa-solid fa-film"></i>
            </div>
            <div>
                <h3>Latest Movies</h3>
                <p>Book tickets in advance</p>
            </div>
        </div>

        <div class="bms-service">
            <div class="service-icon">
                <i class="fa-solid fa-microphone"></i>
            </div>
            <div>
                <h3>Comedy Shows</h3>
                <p>Laugh out loud with pros</p>
            </div>
        </div>

        <div class="bms-service">
            <div class="service-icon">
                <i class="fa-solid fa-guitar"></i>
            </div>
            <div>
                <h3>Music Concerts</h3>
                <p>Live performances nearby</p>
            </div>
        </div>

        <div class="bms-service">
            <div class="service-icon">
                <i class="fa-solid fa-trophy"></i>
            </div>
            <div>
                <h3>Sports Matches</h3>
                <p>Cheer for your team</p>
            </div>
        </div>
    </section>

    <!-- EVENTS & SHOWS GRID -->
    <section class="bms-products" id="bms-products">
        <div class="bms-section-header">
            <div>
                <h2>Trending Entertainment Events</h2>
                <p>Discover movies and events handpicked for you</p>
            </div>
            <a href="/bookmyshow" class="bms-view-all">
                View All
                <i class="fa-solid fa-arrow-right"></i>
            </a>
        </div>

        <div class="bms-product-grid">
            <% if (typeof products !== 'undefined' && products.length > 0) { %>
                <% products.slice(0, 12).forEach(product => { %>
                    <div class="bms-product-card">
                        <div class="bms-product-image">
                            <img src="<%= product.image %>" alt="<%= product.title %>" loading="lazy">
                            <span class="bms-product-rating">
                                <i class="fa-solid fa-star"></i> <%= product.rating %>
                            </span>
                        </div>

                        <div class="bms-product-info">
                            <span class="bms-product-category"><%= product.category %></span>
                            <h3><%= product.title %></h3>
                            <p><%= product.description %></p>

                            <div class="bms-product-bottom">
                                <div>
                                    <small>Price starts at</small>
                                    <strong>₹<%= product.price %></strong>
                                </div>
                                <a href="/bookmyshow/product/<%= product._id %>" class="bms-view-btn">
                                    Book
                                    <i class="fa-solid fa-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="bms-no-data">
                    <p>No events found right now. Check back later!</p>
                </div>
            <% } %>
        </div>
    </section>

    <!-- CATEGORIES -->
    <section class="bms-categories" id="bms-categories">
        <div class="bms-section-header">
            <div>
                <h2>Explore By Category</h2>
                <p>Find what interests you the most</p>
            </div>
        </div>

        <div class="bms-category-grid">
            <a href="/bookmyshow/category/Movies" class="bms-category-card">
                <div class="bms-category-icon"><i class="fa-solid fa-film"></i></div>
                <h3>Movies</h3>
                <span>Cinema & IMAX</span>
            </a>

            <a href="/bookmyshow/category/Comedy%20Shows" class="bms-category-card">
                <div class="bms-category-icon"><i class="fa-solid fa-face-laugh-squint"></i></div>
                <h3>Comedy</h3>
                <span>Standup & Improv</span>
            </a>

            <a href="/bookmyshow/category/Concerts" class="bms-category-card">
                <div class="bms-category-icon"><i class="fa-solid fa-music"></i></div>
                <h3>Concerts</h3>
                <span>Live Music</span>
            </a>

            <a href="/bookmyshow/category/Sports" class="bms-category-card">
                <div class="bms-category-icon"><i class="fa-solid fa-futbol"></i></div>
                <h3>Sports</h3>
                <span>Live Matches</span>
            </a>

            <a href="/bookmyshow/category/Plays" class="bms-category-card">
                <div class="bms-category-icon"><i class="fa-solid fa-masks-theater"></i></div>
                <h3>Plays</h3>
                <span>Theatre Shows</span>
            </a>

            <a href="/bookmyshow/category/Events" class="bms-category-card">
                <div class="bms-category-icon"><i class="fa-solid fa-calendar-check"></i></div>
                <h3>Events</h3>
                <span>Festivals & Expo</span>
            </a>

            <a href="/bookmyshow/category/Kids" class="bms-category-card">
                <div class="bms-category-icon"><i class="fa-solid fa-child-reaching"></i></div>
                <h3>Kids</h3>
                <span>Family Fun</span>
            </a>

            <a href="/bookmyshow/category/Activities" class="bms-category-card">
                <div class="bms-category-icon"><i class="fa-solid fa-ticket"></i></div>
                <h3>Activities</h3>
                <span>Fun Rides & Parks</span>
            </a>
        </div>
    </section>

</div>

<script>
// Optional Javascript for smooth interactions
document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function (e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute('href'));
        if(target){
            target.scrollIntoView({
                behavior: 'smooth'
            });
        }
    });
});
</script>

<style>
/* BOOKMYSHOW STYLES */
.bms-page {
    width: 100%;
    min-height: 100vh;
    background: #fdf8fa;
    padding: 18px 0 55px;
    font-family: Arial, sans-serif;
}

.bms-page * {
    box-sizing: border-box;
}

/* HERO */
.bms-hero {
    width: calc(100% - 30px);
    max-width: 1380px;
    min-height: 350px;
    margin: auto;
    padding: 45px 65px;
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    overflow: hidden;
    position: relative;
    background: linear-gradient(115deg, #fff0f3 0%, #ffe3e8 50%, #fcd0d7 100%);
}

.bms-hero-content {
    width: 58%;
    position: relative;
    z-index: 2;
}

.bms-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 14px;
    border-radius: 30px;
    background: #e6234e;
    color: white;
    font-size: 12px;
    font-weight: 600;
    margin-bottom: 15px;
}

.bms-hero-content h1 {
    margin: 0;
    color: #330d17;
    font-size: 45px;
    line-height: 1.1;
}

.bms-hero-content h1 span {
    color: #e6234e;
}

.bms-hero-content p {
    max-width: 570px;
    margin: 16px 0 24px;
    color: #734d56;
    font-size: 15px;
    line-height: 1.6;
}

.bms-buttons {
    display: flex;
    gap: 10px;
}

.bms-primary-btn, .bms-secondary-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    border-radius: 7px;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition: .25s;
}

.bms-primary-btn {
    background: #e6234e;
    color: white;
}

.bms-primary-btn:hover {
    background: #c7173e;
    color: white;
    transform: translateY(-2px);
}

.bms-secondary-btn {
    background: white;
    color: #e6234e;
    border: 1px solid #f8b3c1;
}

.bms-secondary-btn:hover {
    background: #fff5f7;
    color: #c7173e;
}

/* HERO VISUAL */
.bms-hero-visual {
    width: 38%;
    height: 280px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 2;
}

.bms-globe {
    width: 225px;
    height: 225px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255,255,255,.6);
    box-shadow: 0 15px 35px rgba(230,35,78,.12);
}

.bms-globe i {
    font-size: 105px;
    color: #e6234e;
}

.bms-float-card {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 10px 13px;
    background: white;
    border-radius: 9px;
    box-shadow: 0 8px 22px rgba(0,0,0,.1);
}

.bms-float-card i {
    width: 35px;
    height: 35px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 7px;
    background: #ffe6eb;
    color: #e6234e;
}

.bms-float-card strong { display: block; font-size: 12px; color: #222; }
.bms-float-card small { display: block; margin-top: 2px; font-size: 9px; color: #888; }
.card-one { top: 35px; right: 0; }
.card-two { bottom: 30px; left: 5px; }

/* SERVICES */
.bms-services {
    width: calc(100% - 30px);
    max-width: 1380px;
    margin: 20px auto 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
}

.bms-service {
    background: white;
    border: 1px solid #f2dbe0;
    border-radius: 11px;
    padding: 16px;
    display: flex;
    align-items: center;
    gap: 12px;
}

.service-icon {
    width: 45px;
    height: 45px;
    flex-shrink: 0;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #ffe6eb;
    color: #e6234e;
}

.bms-service h3 { margin: 0 0 4px; font-size: 13px; color: #222; }
.bms-service p { margin: 0; font-size: 10px; color: #888; }

/* PRODUCTS & CATEGORIES */
.bms-products, .bms-categories {
    width: calc(100% - 30px);
    max-width: 1380px;
    margin: 36px auto 0;
}

.bms-section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
}

.bms-section-header h2 { margin: 0 0 5px; color: #222; font-size: 24px; }
.bms-section-header p { margin: 0; color: #777; font-size: 13px; }
.bms-view-all { color: #e6234e; font-size: 13px; font-weight: 600; text-decoration: none; }

.bms-product-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
}

.bms-product-card {
    overflow: hidden;
    background: white;
    border: 1px solid #f2dbe0;
    border-radius: 12px;
    transition: .25s;
}

.bms-product-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(230,35,78,.1);
}

.bms-product-image {
    height: 190px;
    position: relative;
    overflow: hidden;
    background: #fdf0f3;
}

.bms-product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: .3s;
}

.bms-product-card:hover .bms-product-image img { transform: scale(1.05); }

.bms-product-rating {
    position: absolute;
    top: 10px;
    right: 10px;
    padding: 5px 8px;
    border-radius: 5px;
    background: #e6234e;
    color: white;
    font-size: 10px;
}

.bms-product-info { padding: 14px; }
.bms-product-category { color: #e6234e; font-size: 10px; font-weight: 700; text-transform: uppercase; }
.bms-product-info h3 { margin: 6px 0; color: #222; font-size: 16px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.bms-product-info p { height: 32px; margin: 0 0 13px; overflow: hidden; color: #777; font-size: 11px; line-height: 1.45; }

.bms-product-bottom { display: flex; align-items: flex-end; justify-content: space-between; }
.bms-product-bottom small { display: block; color: #999; font-size: 9px; margin-bottom: 2px; }
.bms-product-bottom strong { display: block; color: #222; font-size: 18px; }

.bms-view-btn {
    border: 1px solid #e6234e;
    background: white;
    color: #e6234e;
    padding: 7px 12px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 600;
    text-decoration: none;
    transition: .2s;
    display: inline-flex;
    align-items: center;
    gap: 5px;
}

.bms-view-btn:hover { background: #e6234e; color: white; }

.bms-no-data {
    grid-column: 1 / -1;
    text-align: center;
    padding: 40px;
    background: #fff;
    border-radius: 12px;
    color: #777;
}

/* CATEGORY GRID */
.bms-category-grid {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 13px;
}

.bms-category-card {
    min-height: 125px;
    padding: 15px 8px;
    background: white;
    border: 1px solid #f2dbe0;
    border-radius: 11px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    text-decoration: none;
    transition: .25s;
}

.bms-category-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 20px rgba(0,0,0,.07);
    border-color: #f8b3c1;
}

.bms-category-icon {
    width: 52px;
    height: 52px;
    margin-bottom: 10px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #ffe6eb;
    color: #e6234e;
    font-size: 21px;
}

.bms-category-card h3 { margin: 0 0 4px; color: #222; font-size: 12px; }
.bms-category-card span { color: #999; font-size: 9px; }

/* RESPONSIVE */
@media (max-width: 1200px) {
    .bms-product-grid { grid-template-columns: repeat(3, 1fr); }
    .bms-category-grid { grid-template-columns: repeat(4, 1fr); }
}

@media (max-width: 900px) {
    .bms-hero { padding: 35px; }
    .bms-hero-content { width: 100%; }
    .bms-hero-visual { display: none; }
    .bms-services { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 650px) {
    .bms-product-grid, .bms-category-grid { grid-template-columns: repeat(2, 1fr); }
}
</style>

<%- include("../../shopping/commonHeader/footer") %>