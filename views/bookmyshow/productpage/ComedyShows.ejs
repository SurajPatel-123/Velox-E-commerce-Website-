<%- include("../../shopping/commonHeader/header") %>
<%- include("../../shopping/commonHeader/navbar4") %>

<% 
  // Defensive check: Falls back across common show/event variables or an empty array
  const comedyShowsItems = (typeof comedyshows !== 'undefined' && Array.isArray(comedyshows)) ? comedyshows : 
                          (typeof comedy !== 'undefined' && Array.isArray(comedy)) ? comedy : 
                          (typeof shows !== 'undefined' && Array.isArray(shows)) ? shows : 
                          (typeof events !== 'undefined' && Array.isArray(events)) ? events : 
                          (typeof activities !== 'undefined' && Array.isArray(activities)) ? activities : 
                          (typeof products !== 'undefined' && Array.isArray(products)) ? products : []; 
%>

<div class="comedy-page">

    <!-- HERO HEADER SECTION -->
    <div class="comedy-header">
        <h2>🎙️ Stand-Up & Comedy Shows</h2>
        <p>Get ready to laugh out loud! Book tickets for top comedians, open mics, and live comedy tours.</p>
    </div>

    <!-- FILTER & SEARCH BAR SECTION -->
    <div class="filter-section">
        <form id="filterForm" class="filter-wrapper" onsubmit="event.preventDefault(); applyFilters();">
            
            <!-- Search Bar -->
            <div class="filter-group search-group">
                <i class="fa-solid fa-magnifying-glass search-icon"></i>
                <input 
                    type="text" 
                    id="searchInput" 
                    placeholder="Search by artist, show, or title..." 
                    onkeyup="applyFilters()"
                >
            </div>

            <!-- Category / Genre Filter -->
            <div class="filter-group">
                <select id="categoryFilter" onchange="applyFilters()">
                    <option value="">All Categories</option>
                    <option value="Stand-Up">Stand-Up Comedy</option>
                    <option value="Open Mic">Open Mic</option>
                    <option value="Improv">Improv</option>
                    <option value="Crowd Work">Crowd Work</option>
                </select>
            </div>

            <!-- Location Filter -->
            <div class="filter-group">
                <select id="locationFilter" onchange="applyFilters()">
                    <option value="">All Locations</option>
                    <option value="Mumbai">Mumbai</option>
                    <option value="Delhi">Delhi NCR</option>
                    <option value="Bengaluru">Bengaluru</option>
                    <option value="Hyderabad">Hyderabad</option>
                    <option value="Pune">Pune</option>
                </select>
            </div>

            <!-- Max Price Filter -->
            <div class="filter-group">
                <select id="priceFilter" onchange="applyFilters()">
                    <option value="">Any Price</option>
                    <option value="499">Under ₹499</option>
                    <option value="999">Under ₹999</option>
                    <option value="1999">Under ₹1,999</option>
                </select>
            </div>

            <!-- Reset Button -->
            <button type="button" class="reset-filter-btn" onclick="resetFilters()">
                <i class="fa-solid fa-rotate-right"></i> Reset
            </button>
        </form>
    </div>

    <!-- MAIN CONTAINER -->
    <div class="comedy-container" id="comedyContainer">

        <% if (comedyShowsItems.length === 0) { %>
            <div class="no-results-box">
                <h3 style="color: #64748b;">No comedy shows scheduled right now.</h3>
                <p style="color: #94a3b8;">Please check back later or explore other entertainment categories!</p>
            </div>
        <% } else { %>
            <% comedyShowsItems.forEach(show => { %>
                <div 
                    class="comedy-card" 
                    data-title="<%= (show.title || '').toLowerCase() %>"
                    data-category="<%= (show.category || show.genre || show.language || 'Stand-Up').toLowerCase() %>"
                    data-location="<%= (show.location || show.venue || '').toLowerCase() %>"
                    data-price="<%= show.price || 0 %>"
                >
                    <a href="/bookmyshow/product/<%= show._id %>" class="comedy-link">

                        <!-- IMAGE CONTAINER WITH WISHLIST BUTTON -->
                        <div class="comedy-img-wrapper">
                            <button 
                                type="button" 
                                class="wishlist-icon-btn" 
                                onclick="event.preventDefault(); event.stopPropagation(); toggleWishlist('<%= show._id %>', this)"
                                aria-label="Save to Wishlist"
                            >
                                <% if (typeof user !== 'undefined' && user && user.wishlist && user.wishlist.includes(show._id)) { %>
                                    <i class="fa-solid fa-heart active-heart"></i>
                                <% } else { %>
                                    <i class="fa-regular fa-heart"></i>
                                <% } %>
                            </button>

                            <img src="<%= show.image || show.img || '/images/default.jpg' %>" alt="<%= show.title %>" loading="lazy">
                            <span class="badge-category"><%= show.category || show.genre || show.language || 'Stand-Up' %></span>
                        </div>

                        <!-- CARD DETAILS -->
                        <div class="comedy-details">
                            <div class="comedy-location">
                                <i class="fa-solid fa-location-dot"></i> <%= show.location || show.venue || 'Live Venue' %>
                            </div>

                            <h3><%= show.title %></h3>

                            <p class="description"><%= show.description %></p>

                            <div class="meta-info">
                                <div class="rating">
                                    ⭐ <%= show.rating || '4.9' %> <span class="reviews">(<%= show.reviewsCount || '120+' %> reviews)</span>
                                </div>
                            </div>

                            <div class="card-footer">
                                <div class="price-wrapper">
                                    <span class="price-label">Ticket starting from</span>
                                    <div class="price">₹<%= show.price ? show.price.toLocaleString("en-IN") : '0' %></div>
                                </div>

                                <button type="button"
                                    class="book-now-btn"
                                    onclick="event.preventDefault(); event.stopPropagation(); bookNow('<%= show._id %>')">  
                                    <i class="fa-solid fa-ticket"></i> Book Show
                                </button>
                            </div>
                        </div>

                    </a>
                </div>
            <% }) %>
        <% } %>

        <!-- Dynamic Empty Search Result State -->
        <div id="noMatchBox" class="no-results-box" style="display: none;">
            <h3 style="color: #64748b;">No matching comedy shows found.</h3>
            <p style="color: #94a3b8;">Try adjusting your filters or search keywords.</p>
        </div>

    </div>

</div>

<%- include("../../shopping/commonHeader/footer") %>

<style>
/* =========================
   GLOBAL RESET
========================= */

.comedy-page,
.comedy-page * {
    box-sizing: border-box;
}

/* =========================
   PAGE CONTAINER
========================= */

.comedy-page {
    width: 100%;
    max-width: 100vw;
    background: #fdf2f8; 
    padding: 25px 30px;
    overflow-x: hidden;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

/* =========================
   PAGE HEADER
========================= */

.comedy-header {
    margin: 0 0 20px 5px;
}

.comedy-header h2 {
    margin: 0;
    font-size: 30px;
    font-weight: 700;
    color: #831843;
}

.comedy-header p {
    margin: 8px 0 0;
    font-size: 15px;
    color: #be185d;
}

/* =========================
   FILTER BAR
========================= */

.filter-section {
    background: #ffffff;
    padding: 16px 20px;
    border-radius: 14px;
    border: 1px solid #fbcfe8;
    box-shadow: 0 4px 14px rgba(190, 24, 93, 0.05);
    margin-bottom: 25px;
}

.filter-wrapper {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
}

.filter-group {
    flex: 1;
    min-width: 160px;
}

.search-group {
    flex: 2;
    min-width: 240px;
    position: relative;
}

.search-icon {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: #94a3b8;
    font-size: 14px;
}

.search-group input {
    width: 100%;
    padding: 10px 12px 10px 38px;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    outline: none;
    font-size: 14px;
    color: #1e293b;
    transition: border-color 0.2s ease;
}

.search-group input:focus {
    border-color: #be185d;
}

.filter-group select {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    outline: none;
    font-size: 14px;
    color: #334155;
    background-color: #ffffff;
    cursor: pointer;
    transition: border-color 0.2s ease;
}

.filter-group select:focus {
    border-color: #be185d;
}

.reset-filter-btn {
    padding: 10px 16px;
    border: 1px solid #e2e8f0;
    background: #f8fafc;
    color: #64748b;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
    transition: all 0.2s ease;
}

.reset-filter-btn:hover {
    background: #f1f5f9;
    color: #831843;
}

.no-results-box {
    grid-column: 1 / -1; 
    text-align: center; 
    padding: 50px 20px;
}

/* =========================
   GRID CONTAINER
========================= */

.comedy-container {
    width: 100%;
    display: grid !important;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
}

/* =========================
   COMEDY CARD
========================= */

.comedy-card {
    width: 100% !important;
    border-radius: 16px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    background: #ffffff;
    border: 1px solid #fbcfe8;
}

.comedy-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 28px rgba(190, 24, 93, 0.15);
}

.comedy-link {
    width: 100%;
    height: 100%;
    display: flex !important;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
}

/* =========================
   IMAGE & BADGE
========================= */

.comedy-img-wrapper {
    width: 100%;
    height: 220px !important;
    position: relative;
    overflow: hidden;
    background: #e2e8f0;
}

.comedy-img-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
}

.comedy-card:hover .comedy-img-wrapper img {
    transform: scale(1.08);
}

.badge-category {
    position: absolute;
    bottom: 12px;
    left: 12px;
    background: rgba(131, 24, 67, 0.85);
    backdrop-filter: blur(4px);
    color: #ffffff;
    font-size: 11px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 20px;
}

/* =========================
   WISHLIST BUTTON
========================= */

.wishlist-icon-btn {
    position: absolute;
    top: 12px;
    right: 12px;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(4px);
    border: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 17px;
    color: #64748b;
    cursor: pointer;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    transition: all 0.2s ease;
    z-index: 10;
    outline: none;
}

.wishlist-icon-btn:hover {
    background: #ffffff;
    color: #be185d;
}

.wishlist-icon-btn .active-heart {
    color: #be185d !important;
    animation: pop 0.3s ease;
}

@keyframes pop {
    0% { transform: scale(1); }
    50% { transform: scale(1.3); }
    100% { transform: scale(1); }
}

/* =========================
   DETAILS
========================= */

.comedy-details {
    width: 100%;
    padding: 18px;
    background: #ffffff;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
}

.comedy-location {
    font-size: 12px;
    font-weight: 600;
    color: #be185d;
    margin-bottom: 6px;
    display: flex;
    align-items: center;
    gap: 4px;
}

.comedy-page .comedy-details h3 {
    margin: 0;
    font-size: 17px;
    font-weight: 700;
    line-height: 1.3;
    color: #0f172a;
    min-height: 44px;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.comedy-page .comedy-details .description {
    margin: 8px 0 14px 0;
    font-size: 13px;
    line-height: 1.4;
    color: #64748b;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 36px;
}

.meta-info {
    margin-bottom: 14px;
}

.rating {
    font-size: 13px;
    font-weight: 600;
    color: #d97706;
}

.reviews {
    color: #94a3b8;
    font-weight: 400;
    font-size: 12px;
}

/* =========================
   FOOTER & BUTTON
========================= */

.card-footer {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding-top: 12px;
    border-top: 1px solid #f1f5f9;
}

.price-wrapper {
    display: flex;
    flex-direction: column;
}

.price-label {
    font-size: 11px;
    color: #94a3b8;
}

.price {
    font-size: 18px;
    font-weight: 800;
    color: #be185d;
}

.book-now-btn {
    cursor: pointer;
    outline: none;
    border: none;
    border-radius: 10px;
    font-size: 13px;
    font-weight: 600;
    padding: 0 14px;
    height: 38px;
    gap: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #be185d;
    color: white;
    transition: background-color 0.2s ease;
}

.book-now-btn:hover {
    background-color: #9d174d;
}

/* =========================
   RESPONSIVE BREAKPOINTS
========================= */

@media (max-width: 1200px) {
    .comedy-page .comedy-container {
        grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
    }
}

@media (max-width: 850px) {
    .comedy-page {
        padding: 15px;
    }

    .comedy-page .comedy-container {
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        gap: 16px;
    }

    .filter-group {
        min-width: 45%;
    }

    .search-group {
        min-width: 100%;
    }
}

@media (max-width: 480px) {
    .comedy-page .comedy-container {
        grid-template-columns: 1fr !important;
    }

    .comedy-img-wrapper {
        height: 200px !important;
    }

    .filter-group {
        min-width: 100%;
    }
}
</style>

<script>
const currentUser = <%- JSON.stringify(typeof user !== 'undefined' ? user : null) %>;

function bookNow(showId) {
    window.location.href = `/bookmyshow/product/${showId}`;
}

// CLIENT-SIDE FILTERING LOGIC
function applyFilters() {
    const searchValue = document.getElementById('searchInput').value.toLowerCase().trim();
    const categoryValue = document.getElementById('categoryFilter').value.toLowerCase();
    const locationValue = document.getElementById('locationFilter').value.toLowerCase();
    const priceValue = document.getElementById('priceFilter').value;

    const cards = document.querySelectorAll('.comedy-card');
    let visibleCount = 0;

    cards.forEach(card => {
        const title = card.getAttribute('data-title') || '';
        const category = card.getAttribute('data-category') || '';
        const location = card.getAttribute('data-location') || '';
        const price = parseFloat(card.getAttribute('data-price')) || 0;

        const matchesSearch = title.includes(searchValue);
        const matchesCategory = !categoryValue || category.includes(categoryValue);
        const matchesLocation = !locationValue || location.includes(locationValue);
        const matchesPrice = !priceValue || price <= parseFloat(priceValue);

        if (matchesSearch && matchesCategory && matchesLocation && matchesPrice) {
            card.style.display = 'block';
            visibleCount++;
        } else {
            card.style.display = 'none';
        }
    });

    const noMatchBox = document.getElementById('noMatchBox');
    if (noMatchBox) {
        noMatchBox.style.display = visibleCount === 0 ? 'block' : 'none';
    }
}

function resetFilters() {
    document.getElementById('searchInput').value = '';
    document.getElementById('categoryFilter').value = '';
    document.getElementById('locationFilter').value = '';
    document.getElementById('priceFilter').value = '';
    applyFilters();
}

async function toggleWishlist(showId, btnElement) {
    if (!currentUser) {
        alert("Please login to save comedy shows.");
        window.location.href = "/auth/login";
        return;
    }

    const icon = btnElement.querySelector('i');
    const isCurrentlyInWishlist = icon.classList.contains('fa-solid');

    try {
        const endpoint = isCurrentlyInWishlist ? '/wishlist/entertainment/remove' : '/wishlist/entertainment/add';
        const response = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ productId: showId })
        });

        const data = await response.json();

        if (response.ok && data.success) {
            if (isCurrentlyInWishlist) {
                icon.className = 'fa-regular fa-heart';
            } else {
                icon.className = 'fa-solid fa-heart active-heart';
            }
        } else {
            alert(data.message || "Failed to update wishlist.");
        }
    } catch (err) {
        console.error("Wishlist Toggle Error:", err);
        alert("Server connection error. Please try again.");
    }
}
</script>